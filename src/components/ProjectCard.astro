---
import Tag from './Tag.astro';

interface Props {
  index: string;
  eyebrow: string;
  gradient: 'teal-terracotta' | 'sand-teal';
  bigNumber: string;
  bigUnit: string;
  topRow: string;
  title: string;
  desc: string;
  tags: string[];
  cta: string;
  href: string;
  reveal?: string;
}

const { index, eyebrow, gradient, bigNumber, bigUnit, topRow, title, desc, tags, cta, href, reveal } = Astro.props;

const gradientClass = gradient === 'teal-terracotta' ? 'thumb-teal' : 'thumb-sand';
---

<article class="work-card" data-reveal={reveal}>
  <div class={`thumb ${gradientClass}`}>
    <span class="thumb-top">{eyebrow}</span>
    <span class="thumb-idx" aria-hidden="true">{index}</span>
  </div>
  <div class="work-body">
    <p class="bignum">
      {bigNumber}
      <span class="unit">{bigUnit}</span>
    </p>
    <div class="top-row">
      <span>{topRow}</span>
    </div>
    <h3>{title}</h3>
    <p class="desc">{desc}</p>
    <Tag tags={tags} />
    <a class="card-cta" href={href}>
      {cta}
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>

<style>
  .work-card {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    background: var(--card);
    transition: transform 350ms var(--ease-out), box-shadow 350ms var(--ease-out);
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 50px color-mix(in oklch, var(--fg) 12%, transparent);
  }

  .thumb {
    position: relative;
    min-height: 190px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 16px 18px;
    background-size: 170% 170%;
    background-position: 0% 40%;
    transition: background-position 900ms var(--ease-out);
  }

  .work-card:hover .thumb {
    background-position: 100% 60%;
  }

  .thumb-teal {
    background-image: linear-gradient(135deg, var(--theme-primary), var(--theme-complementary));
  }

  .thumb-sand {
    background-image: linear-gradient(135deg, var(--theme-secondary), var(--theme-primary));
  }

  .thumb-top {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  .thumb-idx {
    font-family: var(--font-display);
    font-size: 15px;
    color: rgba(255, 255, 255, 0.92);
  }

  .work-body {
    padding: clamp(20px, 2.4vw, 32px);
  }

  .bignum {
    font-family: var(--font-display);
    font-size: clamp(40px, 4.6vw, 60px);
    line-height: 1;
    margin: 0 0 10px;
    font-variant-numeric: tabular-nums;
  }

  .bignum .unit {
    display: block;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-top: 6px;
  }

  .top-row {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 10px;
  }

  .work-body h3 {
    font-size: 21px;
    margin-bottom: 10px;
  }

  .desc {
    font-size: 14px;
    color: var(--fg-muted);
    margin-bottom: 16px;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 4px;
    transition: border-color 250ms var(--ease-out);
  }

  .card-cta .arrow {
    display: inline-block;
    transition: transform 250ms var(--ease-out);
  }

  .card-cta:hover .arrow { transform: translateX(4px); }

  .card-cta:hover { border-color: var(--fg); }
</style>
