---
interface NavLink {
  href: string;
  label: string;
  match?: string; // substring of pathname considered "current"
}

const links: NavLink[] = [
  { href: '/', label: 'Home', match: '/' },
  { href: '/projects/', label: 'Projects', match: '/projects' },
  { href: '/info/', label: 'About · CV', match: '/info' },
  { href: '/cards-analysis/', label: 'Card Lab', match: '/cards-analysis' },
  { href: '/hf-risk/', label: 'HF-RISK', match: '/hf-risk' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(link: NavLink): boolean {
  if (link.match === '/') return current === '/';
  return current.startsWith(link.match!);
}
---

<nav class="nav" aria-label="Primary">
  <div class="wrap inner">
    <a class="nav-brand" href="/" aria-label="Nikunj Prajapati — home">
      <span class="mark" aria-hidden="true">N</span>
      <span class="brand-meta">
        <span class="name">Nikunj Prajapati</span>
        <span class="sub">Data Analytics</span>
      </span>
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <button
        class="theme-toggle"
        type="button"
        aria-pressed="false"
        aria-label="Toggle dark mode"
      >
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <span data-theme-label>Dark</span>
      </button>
    </div>
  </div>
</nav>
