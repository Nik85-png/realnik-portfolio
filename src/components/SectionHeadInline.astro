---
interface Props {
  num: string;
  title: string;
  lede?: string;
  reveal?: boolean;
  /** Anchor id for the <h2> — lets a section point aria-labelledby at it. */
  id?: string;
}

const { num, title, lede, reveal = true, id } = Astro.props;
---

<div class="section-head" data-reveal={reveal ? '1' : undefined}>
  <div>
    <p class="section-num">{num}</p>
    <h2 id={id} set:html={title} />
  </div>
  {lede && <p class="lede" set:html={lede} />}
</div>

<style>
  .section-head {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .section-num {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 14px;
  }

  .section-num::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--fg-muted);
  }

  .section-head h2 {
    font-size: clamp(28px, 3.6vw, 52px);
    margin: 0;
  }

  .section-head h2 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .lede {
    max-width: 62ch;
    color: var(--fg-muted);
    margin: 0;
    font-size: 15px;
  }

  @media (max-width: 820px) {
    .section-head { grid-template-columns: 1fr; align-items: start; }
  }
</style>
