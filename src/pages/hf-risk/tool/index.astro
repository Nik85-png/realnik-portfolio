  .cal .cideal {
    stroke: color-mix(in oklch, var(--fg) 30%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .cal .cline {
    fill: none;
    stroke: var(--theme-complementary);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .cal .cline.gcs { stroke: var(--theme-primary); }
  .cal .cdot { fill: var(--theme-complementary); stroke: var(--bg); stroke-width: 2; }
  .cal .cdot.gcs { fill: var(--theme-primary); }
  .cal .cdot.is-active { stroke: var(--fg); }
  .cal .ctick { fill: var(--fg-muted); font-size: 11px; font-family: var(--font-body); }
  .cal .ylab { text-anchor: middle; }

  .cal-table { width: 100%; border-collapse: collapse; font-size: 12.6px; font-variant-numeric: tabular-nums; }

  .cal-table th, .cal-table td { text-align: right; padding: 9px 10px; border-bottom: 1px solid var(--rule-soft); }
  .cal-table thead th { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-muted); font-weight: 400; }
  .cal-table tbody th { text-align: left; font-weight: 400; font-family: var(--font-body); }
  .cal-table tbody tr { transition: background-color 220ms var(--ease-out); }
  .cal-table tbody tr.is-active { background: color-mix(in oklch, var(--fg) 5%, transparent); }
  .cal-note { font-size: 11.8px; line-height: 1.6; color: var(--fg-muted); margin: 14px 0 0; max-width: 72ch; }

  /* ---------- meaning ---------- */

  .mean-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule-soft); border: 1px solid var(--rule-soft); }
  @media (max-width: 1000px) { .mean-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 660px) { .mean-grid { grid-template-columns: 1fr; } }

  .mean-card { background: var(--bg); padding: clamp(20px, 2.4vw, 30px); }
  .mean-card-warn { background: color-mix(in oklch, var(--theme-complementary) 7%, var(--bg)); }
  .mean-k { font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg-muted); margin: 0 0 10px; }
  .mean-card h3 { font-size: 17px; margin-bottom: 0.55em; }
  .mean-card p { font-size: 13.2px; color: var(--fg-muted); margin: 0; }
  .mean-card p em { font-style: italic; color: var(--fg); }
  .mean-card code { font-size: 12px; }

  /* ---------- provenance ---------- */

  .prov-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 2.4vw, 30px); }
  @media (max-width: 1000px) { .prov-grid { grid-template-columns: 1fr; } }

  .chain { margin: 0; padding-left: 18px; display: grid; gap: 10px; }
  .chain li { font-size: 12.6px; color: var(--fg-muted); }
  .chain code, .prov-p code { font-family: var(--font-body); font-size: 11.2px; word-break: break-word; }

  .checks { margin: 0; display: grid; gap: 11px; }
  .checks > div { border-bottom: 1px solid var(--rule-soft); padding-bottom: 10px; }
  .checks > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .checks dt { font-size: 12.2px; color: var(--fg); margin-bottom: 4px; }
  .checks dd { margin: 0; font-size: 12px; color: var(--fg-muted); line-height: 1.55; }

  .prov-cmd {
    margin: 14px 0 0;
    background: color-mix(in oklch, var(--fg) 6%, transparent);
    border-radius: 6px;
    padding: 12px 14px;
    overflow-x: auto;
  }

  .prov-cmd code { font-family: var(--font-body); font-size: 11.4px; white-space: pre; }
  .prov-p { font-size: 12.8px; color: var(--fg-muted); line-height: 1.65; margin: 0 0 12px; }

  .limits { margin-top: clamp(28px, 3.4vw, 48px); }
  .limits h3 { font-size: 19px; margin-bottom: 0.6em; }
  .limits ul { margin: 0; padding-left: 20px; display: grid; gap: 9px; max-width: 92ch; }
  .limits li { font-size: 13px; color: var(--fg-muted); }

  .tool-cta {
    margin-top: clamp(28px, 3.4vw, 48px);
    border-top: 1px solid var(--rule);
    padding-top: clamp(20px, 2.6vw, 32px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .tool-cta p { margin: 0; font-size: 13.4px; color: var(--fg-muted); max-width: 58ch; }
  .tool-cta-row { display: flex; flex-wrap: wrap; gap: 10px; }

  .tool-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding-block: 26px 60px;
    border-top: 1px solid var(--rule-soft);
    font-size: 12px;
    color: var(--fg-muted);
  }

  .tool-foot a { text-decoration: none; }
  .tool-foot a:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }

  .noscript { padding-block: 20px; font-size: 13px; color: var(--fg-muted); }

  @media (prefers-reduced-motion: reduce) {
    .strip .mk, .afill, .dial-val { transition: none; }
  }
</style>

<script>
  import {
    loadModelData,
    predictBoth,
    gcsAttribution,
    gcsPresence,
    riskPercentile,
    probability,
  } from '../../../scripts/hf-risk-model.js';

  const MODEL_URL = '/data/hf-risk-models.json';
  const CIRC = 326.7; // 2*pi*r for the 52-unit dial radius

  const form = document.getElementById('labForm');
  const outState = document.getElementById('outState');
  const pctNum = document.getElementById('pctNum');
  const dialVal = document.getElementById('dialVal');
  const readoutK = document.getElementById('readoutK');
  const readoutP = document.getElementById('readoutP');
  const readoutFacts = document.getElementById('readoutFacts');
  const cmpDelta = document.getElementById('cmpDelta');
  const densPath = document.getElementById('densPath');
  const mkBase = document.getElementById('mkBase');
  const mkGcs = document.getElementById('mkGcs');
  const stripArm = document.getElementById('stripArm');
  const stripNote = document.getElementById('stripNote');
  const calBase = document.getElementById('calBase');
  const calGcs = document.getElementById('calGcs');
  const calBaseDot = document.getElementById('calBaseDot');
  const calGcsDot = document.getElementById('calGcsDot');
  const attrRows = document.getElementById('attrRows');
  const attrSpan = document.getElementById('attrSpan');
  const attrState = document.getElementById('attrState');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let data = null;
  let arm = 'baseline';
  let firstDraw = true;
  let last = null;

  const ARM_LABEL = { baseline: 'Without GCS', with_gcs: 'With GCS' };

  function pctText(p) {
    const v = p * 100;
    if (v < 1) return v.toFixed(2);
    if (v < 10) return v.toFixed(1);
    return v.toFixed(1);
  }

  /** Tween a number element so a change reads as a movement, not a jump. */
  function tween(el, from, to, decimals, suffix) {
    if (reduced || from === null || Math.abs(to - from) < 1e-9) {
      el.textContent = to.toFixed(decimals) + (suffix || '');
      return;
    }
    const start = performance.now();
    const dur = 620;
    function tick(now) {
      const t = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = (from + (to - from) * eased).toFixed(decimals) + (suffix || '');
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function readForm() {
    const byName = {};
    form.querySelectorAll('[data-feature]').forEach((el) => {
      const name = el.dataset.feature;
      if (el.type === 'checkbox') {
        byName[name] = el.checked ? 1 : 0;
      } else if (el.tagName === 'SELECT') {
        byName[name] = Number(el.value);
      } else {
        const raw = el.value.trim();
        // MIMIC codes verbal response 0 as "untestable (intubated)", and the
        // training pipeline treats 0 as missing. Keeping that mapping here is
        // what stops a 0 typed into the box becoming a fabricated score.
        if (name === 'verbal_response' && raw === '0') {
          byName[name] = null;
        } else {
          byName[name] = raw === '' ? null : Number(raw);
        }
      }
    });
    return byName;
  }

  function applyMedians() {
    if (!data) return;
    data.features.forEach((f) => {
      const el = form.querySelector('[data-feature="' + f.name + '"]');
      if (!el) return;
      const m = f.median;
      if (el.type === 'checkbox') {
        el.checked = Number(m) >= 0.5;
      } else if (el.tagName === 'SELECT') {
        el.value = String(Math.round(Number(m)));
      } else {
        const dec = f.step < 0.1 ? 2 : f.step < 1 ? 1 : 0;
        el.value = Number(m).toFixed(dec);
        el.title = 'Derivation-cohort ' + (f.gcs ? 'charted' : 'training') + ' median: ' + m;
      }
    });
  }

  function clearGcs() {
    form.querySelectorAll('[data-gcs]').forEach((el) => { el.value = ''; });
    render();
  }

  /** Stepped-area path for the holdout risk density. */
  function densityPath(dist) {
    const H = 150;
    const n = dist.n_bins;
    const hi = dist.max || 1;
    const max = Math.max.apply(null, dist.counts.concat([1]));
    const bw = (hi * 1000) / n;
    let d = 'M0 ' + H;
    for (let i = 0; i < n; i++) {
      const h = (dist.counts[i] / max) * H;
      d += ' L' + (i * bw).toFixed(2) + ' ' + (H - h).toFixed(2);
      d += ' L' + ((i + 1) * bw).toFixed(2) + ' ' + (H - h).toFixed(2);
    }
    return d + ' L' + (n * bw).toFixed(2) + ' ' + H + ' Z';
  }

  function calPoints(bins) {
    return bins.map((b) => {
      const x = 40 + b.predicted * 280;
      const y = 320 - b.observed * 280;
      return x.toFixed(1) + ',' + y.toFixed(1);
    });
  }

  function nearestBin(bins, p) {
    let best = 0;
    for (let i = 1; i < bins.length; i++) {
      if (Math.abs(bins[i].predicted - p) < Math.abs(bins[best].predicted - p)) best = i;
    }
    return bins[best];
  }

  function render() {
    if (!data) return;
    const byName = readForm();
    const r = predictBoth(data, byName);
    const active = r[arm];
    const M = data.models[arm];

    // --- dial and headline number
    const prevPct = last ? last.p * 100 : null;
    tween(pctNum, prevPct, active.probability * 100, 1);
    dialVal.style.strokeDashoffset = String(CIRC * (1 - active.probability));
    dialVal.classList.toggle('is-base', arm === 'baseline');

    // --- plain-language reading, built only from exported values
    const dist = M.distribution;
    const pctile = riskPercentile(dist, active.probability);
    const evRate = (M.prevalence * 100).toFixed(1);
    readoutK.textContent = ARM_LABEL[arm] + ' \u00b7 ' + M.n_features + ' inputs';

    const presence = gcsPresence(data, byName);
    let paragraph =
      'The model puts a profile with these ' + M.n_features + ' values at <strong>' +
      pctText(active.probability) + '%</strong> for death within six months of the discharge date. ' +
      'It ranks patients usefully at AUROC ' + data.meta.auroc[arm].reproduced_auc.toFixed(4) +
      ', but it is not a classifier and it cannot tell you which individual will die. ';
    if (arm === 'with_gcs' && !presence.all) {
      paragraph +=
        'GCS is not assessed here, so this arm is reading its trained missing-value branch for all ' +
        'three components \u2014 which is why it tracks the other arm so closely.';
    } else if (arm === 'with_gcs') {
      paragraph +=
        'All three GCS components are assessed, so this arm has more information than the baseline ' +
        'and the two readings are not like-for-like.';
    } else {
      paragraph +=
        'This is the 34-input arm, which never sees a neurological assessment at all.';
    }
    readoutP.innerHTML = paragraph;

    const facts = [
      'Sits above about ' + Math.round(pctile) + '% of the holdout by predicted risk (median ' +
        (dist.quantiles.p50 * 100).toFixed(1) + '%, p95 ' + (dist.quantiles.p95 * 100).toFixed(0) + '%).',
      'Holdout: ' + data.meta.test_n.toLocaleString() + ' admissions, ' +
        data.meta.test_positives.toLocaleString() + ' deaths (' + evRate + '%).',
      'AUPRC ' + M.auprc + ' \u00b7 Brier ' + M.brier + ' \u00b7 ECE ' + M.calibration.ece +
        ' \u2014 against a ' + evRate + '% event rate, guessing the base rate every time would score 0.209 AUPRC.',
      'GCS charted for only ' + (data.meta.gcs_coverage * 100).toFixed(1) + '% of this cohort, so the ' +
        'assessed and unassessed branches are not symmetric.',
    ];
    if (presence.all) {
      facts.push('GCS entered: eye ' + byName.eye_opening + ' \u00b7 verbal ' + byName.verbal_response +
        ' \u00b7 motor ' + byName.movement + '.');
    } else if (arm === 'with_gcs') {
      facts.push('GCS not assessed \u2014 the with-GCS model is on its missing-value branch.');
    }
    readoutFacts.innerHTML = facts.map((f) => '<li>' + f + '</li>').join('');

    // --- both arms, never hidden
    document.querySelectorAll('[data-cmp-pct]').forEach((el) => {
      el.textContent = pctText(r[el.dataset.cmpPct].probability);
    });
    document.querySelectorAll('.cmp-card').forEach((c) => {
      c.classList.toggle('is-active', c.dataset.card === arm);
    });

    const d = r.deltaPoints;
    const sign = d >= 0 ? '+' : '\u2212';
    cmpDelta.textContent =
      'Adding the three GCS components moves this estimate by ' + sign + Math.abs(d).toFixed(2) +
      ' percentage points (' + pctText(r.baseline.probability) + '% \u2192 ' +
      pctText(r.with_gcs.probability) + '%). Across the whole holdout the same change moved AUROC from ' +
      data.meta.auroc.baseline.reproduced_auc + ' to ' + data.meta.auroc.with_gcs.reproduced_auc + ' (+' +
      data.meta.delta_auroc + ', 95% CI 0.0054\u20130.0120).';

    // --- density strip
    densPath.setAttribute('d', densityPath(dist));
    const bx = Math.min(1000, Math.max(0, r.baseline.probability * 1000));
    const gx = Math.min(1000, Math.max(0, r.with_gcs.probability * 1000));
    if (firstDraw && !reduced) {
      mkBase.setAttribute('transform', 'translate(0,0)');
      mkGcs.setAttribute('transform', 'translate(0,0)');
      requestAnimationFrame(() => {
        mkBase.setAttribute('transform', 'translate(' + bx.toFixed(1) + ',0)');
        mkGcs.setAttribute('transform', 'translate(' + gx.toFixed(1) + ',0)');
      });
    } else {
      mkBase.setAttribute('transform', 'translate(' + bx.toFixed(1) + ',0)');
      mkGcs.setAttribute('transform', 'translate(' + gx.toFixed(1) + ',0)');
    }
    stripArm.textContent = ARM_LABEL[arm] + ' distribution';
    stripNote.textContent =
      'One bar per ' + ((dist.max * 100) / dist.n_bins).toFixed(2) + '% slice of predicted risk, counted over the ' +
      data.meta.test_n.toLocaleString() + ' held-out admissions using the ' + ARM_LABEL[arm].toLowerCase() +
      ' model (' + M.n_features + ' inputs). The dashed line marks the share of those patients who actually died ' +
      'within six months \u2014 the density sits to the left of it because most predicted risks are below the base rate.';

    // --- calibration
    calBase.setAttribute('points', calPoints(data.models.baseline.calibration.bins).join(' '));
    calGcs.setAttribute('points', calPoints(data.models.with_gcs.calibration.bins).join(' '));
    const cb = nearestBin(data.models.baseline.calibration.bins, r.baseline.probability);
    const cg = nearestBin(data.models.with_gcs.calibration.bins, r.with_gcs.probability);
    calBaseDot.setAttribute('cx', String(40 + cb.predicted * 280));
    calBaseDot.setAttribute('cy', String(320 - cb.observed * 280));
    calGcsDot.setAttribute('cx', String(40 + cg.predicted * 280));
    calGcsDot.setAttribute('cy', String(320 - cg.observed * 280));
    calBaseDot.classList.toggle('is-active', arm === 'baseline');
    calGcsDot.classList.toggle('is-active', arm === 'with_gcs');
    document.querySelectorAll('[data-calrow]').forEach((row) => {
      row.classList.toggle('is-active', row.dataset.calrow === arm);
    });

    // --- exact GCS attribution
    const att = gcsAttribution(data, byName);
    const maxPhi = Math.max.apply(null, att.contributions.map((c) => Math.abs(c.phi)).concat([1e-6]));
    att.contributions.forEach((c) => {
      const vEl = attrRows.querySelector('[data-phi="' + c.name + '"]');
      const fEl = attrRows.querySelector('[data-fill="' + c.name + '"]');
      const nEl = attrRows.querySelector('[data-val="' + c.name + '"]');
      const rounded = Math.abs(c.phi) < 5e-4 ? 0 : c.phi;
      vEl.textContent = (rounded >= 0 ? '+' : '\u2212') + Math.abs(rounded).toFixed(3) + ' log-odds';
      const w = c.present ? Math.min(50, (Math.abs(rounded) / maxPhi) * 50) : 0;
      fEl.style.width = w + '%';
      fEl.classList.toggle('neg', rounded < 0);
      nEl.textContent = c.present
        ? 'assessed \u2014 entered as ' + (Number.isInteger(c.value) ? c.value : c.value.toFixed(2))
        : 'not assessed \u2014 missing-value branch; contributes nothing by construction';
    });

    if (att.contributions.every((c) => c.present)) {
      attrState.textContent = 'all three assessed';
      attrState.classList.remove('is-warn');
      attrSpan.innerHTML =
        'With GCS unknown the model reads <strong>' + (probability(att.unknownMargin) * 100).toFixed(1) +
        '%</strong>; with it known, <strong>' + (probability(att.knownMargin) * 100).toFixed(1) + '%</strong>. ' +
        'That is a shift of ' + att.spanPoints.toFixed(2) + ' percentage points (' +
        att.spanLogOdds.toFixed(3) + ' log-odds) inside the with-GCS model, and the three shares above add to exactly that.';
    } else if (att.contributions.some((c) => c.present)) {
      attrState.textContent = 'partly assessed';
      attrState.classList.add('is-warn');
      attrSpan.textContent =
        'Only some components are assessed. A component left blank enters as a missing value, so it is ' +
        'contributing nothing by construction rather than contributing zero \u2014 those two are not the same claim.';
    } else {
      attrState.textContent = 'nothing assessed';
      attrState.classList.add('is-warn');
      attrSpan.textContent =
        'No GCS component is assessed, so the with-GCS model is reading its missing-value branch for all three. ' +
        'Fill the boxes in the form to see what the assessment actually changes.';
    }

    last = { p: active.probability };
    firstDraw = false;
    const countLabel = document.getElementById('labCount');
    if (countLabel) {
      const filled = Object.keys(byName).filter((k) => byName[k] !== null).length;
      countLabel.textContent = filled + ' of ' + Object.keys(byName).length + ' inputs set';
    }
  }

  // --- wiring
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('input', render);
  form.addEventListener('change', render);

  document.querySelectorAll('.armbtn').forEach((btn) => {
    btn.addEventListener('click', () => {
      arm = btn.dataset.arm;
      document.querySelectorAll('.armbtn').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.arm === arm));
      });
      last = null;
      render();
    });
  });

  document.getElementById('medianBtn').addEventListener('click', () => {
    applyMedians();
    last = null;
    render();
  });

  document.getElementById('gcsBtn').addEventListener('click', clearGcs);

  (async function boot() {
    try {
      data = await loadModelData(MODEL_URL);
      applyMedians();
      outState.textContent =
        'Model loaded \u2014 ' + data.meta.n_admissions.toLocaleString() + ' admissions, exported ' +
        data.meta.generated + '. Nothing you enter is sent anywhere.';
      outState.classList.remove('is-warn');
      render();
    } catch (err) {
      outState.textContent = 'The exported model could not be loaded, so no reading is shown.';
      outState.classList.add('is-err');
      readoutK.textContent = 'Model unavailable';
      readoutP.textContent =
        'The ensembles are a static file served from this site (' + MODEL_URL + '). If it failed to load, the ' +
        'figures on this page and the case study still hold \u2014 only the live calculator is disabled.';
      readoutFacts.innerHTML = '';
    }
  })();
</script>

  </div>
</Layout>
