---
/**
 * HF-RISK — on-site interactive prototype.
 *
 * This page replaces the Flask service that used to run on Render. The old
 * tool POSTed to /api/predict on a free-tier dyno, so the first visitor after
 * an idle period met a "Cold-start / unreachable" badge instead of a result.
 * Here the exported XGBoost ensembles are evaluated in the browser
 * (src/scripts/hf-risk-model.js), so there is no service to be asleep, no
 * input leaves the visitor's machine, and the two model arms — with and
 * without the three Glasgow Coma Scale components — can be compared directly.
 */
import Layout from '../../../components/Layout.astro';
import SectionHeadInline from '../../../components/SectionHeadInline.astro';

const CASE_URL = '/hf-risk/';
const GITHUB_URL = 'https://github.com/Nik85-png/hf-risk-heart-failure-ml';
const MODEL_URL = '/data/hf-risk-models.json';

// Two arms, one cohort: the with-GCS arm is the baseline arm plus exactly
// these three features. Both numbers below were reproduced locally from
// scripts/09_mimic_native_gcs_retrain.py and match results/mimic_gcs_run_log.md.
const arms = [
  { key: 'baseline', label: 'Without GCS', features: 34, auroc: '0.8266', auprc: '0.6369', brier: '0.1174', ece: '0.0157' },
  { key: 'with_gcs', label: 'With GCS', features: 37, auroc: '0.8352', auprc: '0.6678', brier: '0.1122', ece: '0.0112' },
];

// Every one of the 37 inputs the model uses is on this page. Nothing is filled
// in behind the visitor's back: untouched numeric fields fall back to the
// derivation-cohort median, which is shown beside each field once the model
// metadata loads.
const groups = [
  {
    title: 'Patient',
    note: 'Age and sex as recorded for the index admission.',
    fields: [
      { name: 'age', label: 'Age', unit: 'years', min: 30, max: 100, step: 1, help: 'Adult heart-failure admissions only; the cohort contains no under-18s.' },
      { name: 'gender', label: 'Sex', type: 'select', options: [{ v: 0, t: 'Female' }, { v: 1, t: 'Male' }] },
      { name: 'cci_score', label: 'Charlson index', unit: 'score', min: 0, max: 14, step: 1, help: 'As recorded in this extract. It is not recomputed from the toggles below.' },
    ],
  },
  {
    title: 'Comorbidities',
    note: 'Counts derived from ICD-coded diagnoses for the admission.',
    fields: [
      { name: 'myocardial_infarction', label: 'Prior myocardial infarction', type: 'flag' },
      { name: 'congestive_heart_failure', label: 'Congestive heart failure', type: 'flag' },
      { name: 'peripheral_vascular_disease', label: 'Peripheral vascular disease', type: 'flag' },
      { name: 'cerebrovascular_disease', label: 'Cerebrovascular disease', type: 'flag' },
      { name: 'dementia', label: 'Dementia', type: 'flag' },
      { name: 'copd', label: 'Chronic pulmonary disease', type: 'flag' },
      { name: 'peptic_ulcer_disease', label: 'Peptic ulcer disease', type: 'flag' },
      { name: 'diabetes', label: 'Diabetes', type: 'flag' },
      { name: 'moderate_to_severe_ckd', label: 'Moderate-to-severe CKD', type: 'flag' },
      { name: 'liver_disease', label: 'Liver disease', type: 'flag' },
      { name: 'solid_tumor', label: 'Solid tumour', type: 'flag' },
      { name: 'aids', label: 'AIDS', type: 'flag' },
      { name: 'hemiplegia', label: 'Hemiplegia', type: 'flag' },
    ],
  },
  {
    title: 'Renal and electrolytes',
    note: 'First values recorded for the admission, in the cohort\'s units.',
    fields: [
      { name: 'creatinine', label: 'Creatinine', unit: 'mg/dL', min: 0.2, max: 12, step: 0.01 },
      { name: 'urea', label: 'Urea nitrogen', unit: 'mg/dL', min: 2, max: 200, step: 1 },
      { name: 'sodium', label: 'Sodium', unit: 'mEq/L', min: 110, max: 165, step: 1 },
      { name: 'potassium', label: 'Potassium', unit: 'mEq/L', min: 2, max: 7.5, step: 0.1 },
      { name: 'chloride', label: 'Chloride', unit: 'mEq/L', min: 75, max: 130, step: 1 },
      { name: 'bicarbonate', label: 'Bicarbonate', unit: 'mEq/L', min: 5, max: 45, step: 1 },
      { name: 'calcium', label: 'Calcium', unit: 'mg/dL', min: 5, max: 14, step: 0.1 },
      { name: 'anion_gap', label: 'Anion gap', unit: 'mEq/L', min: 2, max: 40, step: 1 },
    ],
  },
  {
    title: 'Haematology and cardiac markers',
    note: 'Same windows as above; BNP and troponin are left as recorded.',
    fields: [
      { name: 'hemoglobin', label: 'Haemoglobin', unit: 'g/dL', min: 5, max: 20, step: 0.1 },
      { name: 'hematocrit', label: 'Haematocrit', unit: '%', min: 15, max: 60, step: 0.1 },
      { name: 'platelet', label: 'Platelets', unit: 'K/uL', min: 10, max: 700, step: 1 },
      { name: 'white_blood_cell', label: 'White cell count', unit: 'K/uL', min: 0.5, max: 40, step: 0.1 },
      { name: 'red_blood_cell', label: 'Red blood cell count', unit: 'M/uL', min: 1.5, max: 7, step: 0.01 },
      { name: 'mcv', label: 'Mean corpuscular volume', unit: 'fL', min: 55, max: 130, step: 1 },
      { name: 'rdw', label: 'Red cell distribution width', unit: '%', min: 10, max: 30, step: 0.1 },
      { name: 'albumin', label: 'Albumin', unit: 'g/dL', min: 1, max: 6, step: 0.1 },
      { name: 'brain_natriuretic_peptide', label: 'BNP', unit: 'pg/mL', min: 0, max: 5000, step: 1 },
      { name: 'troponin_t', label: 'Troponin T', unit: 'ng/mL', min: 0, max: 10, step: 0.01 },
    ],
  },
];

const gcsFields = [
  { name: 'eye_opening', label: 'Eye opening', min: 1, max: 4, help: '1 none, 2 to pain, 3 to speech, 4 spontaneous.' },
  { name: 'verbal_response', label: 'Verbal response', min: 1, max: 5, help: 'Coded 0 for "untestable (intubated)" in MIMIC; 0 is treated as not assessed, and 1–5 are the real responses.' },
  { name: 'movement', label: 'Motor response', min: 1, max: 6, help: '1 none to 6 obeys commands.' },
];

const limits = [
  'Research prototype. Not a medical device, not validated for clinical use, and not a substitute for clinical judgement.',
  'The model is retrospective. It was fitted and evaluated on a single MIMIC-IV extract, with no prospective or external validation of this particular pair of models.',
  'The outcome label mixes deaths in hospital with deaths after discharge — audited in full on the case-study page. Until the re-extraction lands, a reading describes "death within six months of the discharge date", which is not the same thing as surviving to discharge and then dying.',
  'Each arm is a separately trained model, so the difference between them is not a pure "effect of GCS" — it also carries the usual variance of two independently fitted ensembles.',
  'GCS is charted for 28.1% of these admissions. If it is left blank here the with-GCS model uses its trained missing-value branch, which is how the majority of the cohort was handled.',
  'The ICU-only subgroup quoted on the case-study page is selected on severity, so it is a collider subgroup and stays descriptive.',
  'Discrimination is moderate. AUROC 0.8352 means the model ranks patients usefully, not that it identifies who will die.',
];
---

<Layout
  title="HF-RISK tool — heart-failure 6-month mortality, with and without GCS"
  description="A leakage-audited MIMIC-IV heart-failure model that runs entirely in your browser: compare 6-month mortality predictions with and without the Glasgow Coma Scale components, on 37 transparent inputs, with real holdout calibration."
  ogType="article"
  ogImage="/hf-risk/assets/shap_bar_icu_only.png"
  keywords={[
    'heart failure risk calculator',
    'Glasgow Coma Scale mortality prediction',
    'MIMIC-IV heart failure model',
    'in-browser machine learning',
    'XGBoost clinical prediction prototype',
  ]}
  schema={{
    '@type': 'SoftwareApplication',
    '@id': 'https://realnik.co.uk/hf-risk/tool/#app',
    name: 'HF-RISK research prototype',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web browser',
    url: 'https://realnik.co.uk/hf-risk/tool/',
    description:
      'Browser-side demonstration of a patient-grouped MIMIC-IV heart-failure model for 6-month mortality, comparing a 34-feature baseline with a 37-feature model that adds the three Glasgow Coma Scale components.',
    isPartOf: { '@id': 'https://realnik.co.uk/hf-risk/#article' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  }}
>
  <div class="tool">

    <div class="warn-strip" role="note">
      <span class="warn-dot" aria-hidden="true">!</span>
      <p>
        <strong>Research prototype — not for clinical use.</strong>
        It demonstrates a method on a de-identified research cohort. It cannot assess a real patient,
        it has not been validated anywhere prospectively, and nothing you enter leaves your browser.
      </p>
    </div>

    <nav class="crumbs wrap" aria-label="Breadcrumb">
      <a href={CASE_URL}><span aria-hidden="true">&larr;</span> HF-RISK case study</a>
      <span class="crumbs-sep" aria-hidden="true">/</span>
      <span>Interactive prototype</span>
    </nav>

    <header class="hero wrap">
      <p class="eyebrow" data-reveal>HF-RISK · interactive prototype</p>
      <h1 data-reveal="1">The same model, <em>running in your browser.</em></h1>
      <p class="deck" data-reveal="2">
        Two patient-grouped XGBoost models for six-month mortality after a heart-failure admission —
        one on 34 clinical inputs, one on the same 34 plus the three Glasgow Coma Scale components.
        The ensembles are exported from the retrain script and evaluated locally, so there is no
        service to cold-start and no reading to wait for.
      </p>

      <dl class="hero-meta" data-reveal="3">
        <div><dt>Cohort</dt><dd>MIMIC-IV heart-failure admissions</dd></div>
        <div><dt>Split</dt><dd>Patient-grouped 80/20, seed 17</dd></div>
        <div><dt>Holdout</dt><dd>8,749 admissions · 1,830 deaths (20.9%)</dd></div>
        <div><dt>Outcome</dt><dd>Death within 6 months of the discharge date</dd></div>
      </dl>

      <div class="stat-strip" data-reveal="4" role="list">
        <div class="stat" role="listitem">
          <p class="k" data-count="42990">0</p>
          <p class="lbl">Admissions</p><p class="sub">18,890 patients · 8,006 with more than one</p>
        </div>
        <div class="stat" role="listitem">
          <p class="k" data-count="0.8086" data-decimals="4">0</p>
          <p class="lbl">Mean AUROC at 6 months</p><p class="sub">0.8266 without GCS · 0.8352 with GCS</p>
        </div>
        <div class="stat" role="listitem">
          <p class="k" data-count="0.0086" data-decimals="4" data-prefix="+">0</p>
          <p class="lbl">Paired AUROC gain from GCS</p><p class="sub">95% CI 0.0054–0.0120</p>
        </div>
        <div class="stat" role="listitem">
          <p class="k" data-count="0.0112" data-decimals="4">0</p>
          <p class="lbl">Calibration error, with GCS</p><p class="sub">Brier 0.1122 on the holdout</p>
        </div>
      </div>
    </header>

<!-- ===== the reading ===== -->
    <section class="section wrap" id="reading" aria-labelledby="reading-h">
      <SectionHeadInline
        id="reading-h"
        num="The reading"
        title="Change an input, <em>watch the estimate move.</em>"
        lede="All 37 inputs the model uses are on this page, grouped and labelled. Anything you leave alone stays at the derivation-cohort median, which is printed beside the field once the model metadata loads — nothing is filled in behind your back."
      />

      <div class="lab">
        <form class="lab-form" id="labForm" autocomplete="off" novalidate>
          <div class="lab-toolbar">
            <div>
              <p class="lab-toolbar-k">Inputs</p>
              <p class="lab-toolbar-n" id="labCount">37 model inputs</p>
            </div>
            <div class="lab-toolbar-actions">
              <button class="btn btn-ghost lab-btn" type="button" id="medianBtn">Cohort medians</button>
              <button class="btn btn-ghost lab-btn" type="button" id="gcsBtn">Mark GCS unassessed</button>
            </div>
          </div>

          {groups.map((g) => (
            <fieldset class="group">
              <legend>{g.title}</legend>
              <p class="group-note">{g.note}</p>
              <div class="group-grid">
                {g.fields.map((f) => (
                  <label class="field" data-fname={f.name}>
                    <span class="field-k">{f.label}{f.unit && <span class="field-unit"> ({f.unit})</span>}</span>
                    {f.type === 'select' ? (
                      <select name={f.name} data-feature={f.name}>
                        {f.options.map((o) => <option value={o.v}>{o.t}</option>)}
                      </select>
                    ) : f.type === 'flag' ? (
                      <span class="flag-wrap">
                        <input type="checkbox" name={f.name} data-feature={f.name} value="1" />
                        <span class="flag-box" aria-hidden="true"></span>
                      </span>
                    ) : (
                      <input
                        type="number"
                        name={f.name}
                        data-feature={f.name}
                        min={f.min}
                        max={f.max}
                        step={f.step}
                        inputmode="decimal"
                      />
                    )}
                    {f.help && <span class="field-help">{f.help}</span>}
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <fieldset class="group group-gcs">
            <legend>Neurological assessment</legend>
            <p class="group-note">
              Glasgow Coma Scale components. Leave a box empty to record that it was
              <em>not assessed</em> — the model then takes its trained missing-value branch, which is
              how 71.9% of this cohort was handled. Clearing the boxes is the honest way to say
              "nobody measured this".
            </p>
            <div class="group-grid">
              {gcsFields.map((f) => (
                <label class="field" data-fname={f.name}>
                  <span class="field-k">{f.label}</span>
                  <input type="number" name={f.name} data-feature={f.name} data-gcs="1" min={f.min} max={f.max} step="1" inputmode="numeric" />
                  {f.help && <span class="field-help">{f.help}</span>}
                </label>
              ))}
            </div>
          </fieldset>
        </form>

        <aside class="out" id="out" aria-live="polite">
          <div class="out-head">
            <div class="armtoggle" role="group" aria-label="Which model arm to read">
              {arms.map((a) => (
                <button type="button" class="armbtn" data-arm={a.key} aria-pressed={a.key === 'baseline' ? 'true' : 'false'}>
                  {a.label}
                </button>
              ))}
            </div>
            <p class="out-state" id="outState">Loading the exported model…</p>
          </div>

          <div class="readout">
            <div class="dial">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="dial-track" cx="60" cy="60" r="52" />
                <circle class="dial-val" id="dialVal" cx="60" cy="60" r="52" />
              </svg>
              <div class="dial-mid">
                <p class="dial-num"><span id="pctNum">–</span><span class="dial-sym">%</span></p>
                <p class="dial-lbl">6-month death</p>
              </div>
            </div>

            <div class="readout-body">
              <p class="readout-k" id="readoutK">Waiting for the model</p>
              <p class="readout-p" id="readoutP">
                The probability appears here once the exported ensembles have been fetched from this
                site. The file is served from <code>/data/</code> and cached, so this happens once per visit.
              </p>
              <ul class="readout-facts" id="readoutFacts"></ul>
            </div>
          </div>

          <div class="cmp">
            {arms.map((a) => (
              <div class="cmp-card" data-card={a.key}>
                <p class="cmp-k">{a.label}</p>
                <p class="cmp-v"><span data-cmp-pct={a.key}>–</span>%</p>
                <p class="cmp-m">{a.features} inputs · AUROC {a.auroc}</p>
              </div>
            ))}
            <p class="cmp-delta" id="cmpDelta">Difference between the arms appears here.</p>
          </div>
        </aside>
      </div>

      <div class="lab-wide">
        <figure class="panel stripfig">
          <figcaption class="cap-head">
            <span class="cap-k">Where this reading sits</span>
            <span class="cap-n" id="stripArm">Without GCS</span>
          </figcaption>
          <svg class="strip" id="stripSvg" viewBox="0 0 1000 214" role="img" aria-labelledby="stripDesc">
            <desc id="stripDesc">Distribution of predicted six-month mortality across the 8,749 held-out admissions, with the current reading marked.</desc>
            <defs>
              <linearGradient id="densFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" style="stop-color:var(--theme-primary);stop-opacity:0.42" />
                <stop offset="100%" style="stop-color:var(--theme-primary);stop-opacity:0.03" />
              </linearGradient>
            </defs>
            <g class="grid" aria-hidden="true">
              <line x1="250" y1="0" x2="250" y2="150" />
              <line x1="500" y1="0" x2="500" y2="150" />
              <line x1="750" y1="0" x2="750" y2="150" />
              <line x1="1000" y1="0" x2="1000" y2="150" />
              <text x="0" y="120">0%</text>
              <text x="1000" y="120" text-anchor="end">100%</text>
            </g>
            <path class="dens" id="densPath" d="" fill="url(#densFill)" stroke="var(--theme-primary)" stroke-width="2" stroke-linejoin="round" />
            <g class="prev" id="prevMark">
              <line y1="0" y2="150" />
              <text y="168">holdout event rate 20.9%</text>
            </g>
            <g class="mk mk-base" id="mkBase">
              <line y1="0" y2="150" />
              <circle cy="150" r="7" />
              <text y="180">without</text>
            </g>
            <g class="mk mk-gcs" id="mkGcs">
              <line y1="0" y2="150" />
              <circle cy="150" r="7" />
              <text y="198">with GCS</text>
            </g>
          </svg>
          <p class="cap-note" id="stripNote">
            One bar per 2.1% slice of predicted risk, counted over the held-out admissions for the
            selected arm. The dashes mark the share of those patients who actually died within six months.
          </p>
        </figure>

        <figure class="panel attrfig">
          <figcaption class="cap-head">
            <span class="cap-k">What the GCS components are doing</span>
            <span class="cap-n" id="attrState">waiting…</span>
          </figcaption>
          <div class="attr-rows" id="attrRows">
            {gcsFields.map((f) => (
              <div class="arow" data-row={f.name}>
                <div class="arow-head">
                  <span class="arow-k">{f.label}</span>
                  <span class="arow-v" data-phi={f.name}>–</span>
                </div>
                <div class="atrack"><i class="afill" data-fill={f.name}></i><span class="azero" aria-hidden="true"></span></div>
                <p class="arow-n" data-val={f.name}>not assessed</p>
              </div>
            ))}
          </div>
          <p class="attr-span" id="attrSpan">–</p>
          <details class="attr-why">
            <summary>How these numbers are produced</summary>
            <p>
              Each bar is the <strong>exact Shapley value</strong> of that component inside the with-GCS
              model, holding the other 34 inputs at your values. Three features means 3! = 6 orderings, so
              it is computed exactly rather than sampled: no approximation is involved. A component that is
              not assessed enters as a missing value, which is the model's own trained branch for it, so the
              three bars sum precisely to the difference between "GCS unknown" and "GCS as entered".
              This is an attribution of the GCS block within this model — it is not a full-model SHAP
              explanation, and it is not labelled as one.
            </p>
          </details>
        </figure>
      </div>

      <figure class="panel calfig">
        <figcaption class="cap-head">
          <span class="cap-k">Does the number mean what it says?</span>
          <span class="cap-n">Calibration, both arms, on the holdout</span>
        </figcaption>
        <div class="cal-wrap">
          <svg class="cal" id="calSvg" viewBox="0 0 340 340" role="img" aria-labelledby="calDesc">
            <desc id="calDesc">Predicted versus observed six-month mortality in ten equal-count risk bands of the held-out admissions, for both model arms.</desc>
            <g class="cgrid" aria-hidden="true">
              <line x1="96" y1="40" x2="96" y2="320" />
              <line x1="152" y1="40" x2="152" y2="320" />
              <line x1="208" y1="40" x2="208" y2="320" />
              <line x1="264" y1="40" x2="264" y2="320" />
              <line x1="40" y1="96" x2="320" y2="96" />
              <line x1="40" y1="152" x2="320" y2="152" />
              <line x1="40" y1="208" x2="320" y2="208" />
              <line x1="40" y1="264" x2="320" y2="264" />
            </g>
            <text class="ctick" x="40" y="334" text-anchor="start">0%</text>
            <text class="ctick" x="320" y="334" text-anchor="end">100%</text>
            <line class="cideal" x1="40" y1="320" x2="320" y2="40" />
            <polyline class="cline" id="calBase" points="" />
            <polyline class="cline gcs" id="calGcs" points="" />
            <circle class="cdot" id="calBaseDot" r="7" />
            <circle class="cdot gcs" id="calGcsDot" r="7" />
            <text class="ctick ylab" x="-180" y="14" transform="rotate(-90)">observed rate &rarr;</text>
          </svg>
          <div class="cal-side">
            <table class="cal-table">
              <thead>
                <tr><th scope="col">Arm</th><th scope="col">AUROC</th><th scope="col">AUPRC</th><th scope="col">Brier</th><th scope="col">ECE</th></tr>
              </thead>
              <tbody>
                {arms.map((a) => (
                  <tr data-calrow={a.key}>
                    <th scope="row">{a.label}</th>
                    <td>{a.auroc}</td><td>{a.auprc}</td><td>{a.brier}</td><td>{a.ece}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="cal-note">
              Each point is one tenth of the holdout, so every point carries the same number of patients.
              The diagonal is perfect calibration. ECE is the reported ten-bin figure; Brier is the mean
              squared error of the probabilities themselves. Higher AUPRC and lower Brier are better, and
              AUPRC should be read against the 20.9% event rate — a model that always predicted that rate
              would score 0.209.
            </p>
          </div>
        </div>
      </figure>
    </section>

<!-- ===== how to read it ===== -->
    <section class="section wrap" id="meaning" aria-labelledby="meaning-h">
      <SectionHeadInline
        id="meaning-h"
        num="How to read it"
        title="A percentage is a measurement, <em>not a verdict.</em>"
        lede="A predicted probability from a retrospective cohort model is one of the least dramatic quantities in medicine. Here is exactly what the number on this page is, what it is not, and which parts of it are uncertain."
      />

      <div class="mean-grid">
        <article class="mean-card" data-reveal>
          <p class="mean-k">What the number is</p>
          <h3>The model's estimate for a profile, not for a person</h3>
          <p>
            The ensembles output the rate at which admissions <em>with these 37 values</em> died within six
            months in the derivation cohort. It is a cohort-level probability attached to a profile. Two
            real patients can share every input here and have completely different outcomes; that is a
            property of the measurement, not a failure of the model.
          </p>
        </article>

        <article class="mean-card" data-reveal="1">
          <p class="mean-k">What the number is not</p>
          <h3>Not a prognosis, not a triage input, not a treatment effect</h3>
          <p>
            Nothing here models what happens <em>next</em>: not the treatment given, not the ward, not the
            patient's own trajectory, not the quality of care. The model has never been tested
            prospectively and has never seen a patient from your hospital. Compare it with a cohort
            prevalence, never with an individual.
          </p>
        </article>

        <article class="mean-card" data-reveal="2">
          <p class="mean-k">Why the two arms agree</p>
          <h3>GCS is deliberately left missing</h3>
          <p>
            In this cohort GCS is charted for 28.1% of admissions, because it is recorded for patients
            who reached intensive care and the majority of heart-failure admissions never did. If you
            clear the three boxes, the with-GCS model takes its trained missing branch and the two arms
            converge. That is the honest behaviour, and it is also the whole reason the extension is
            interesting: a variable that mostly exists for the sickest patients will look powerful.
          </p>
        </article>

        <article class="mean-card" data-reveal="3">
          <p class="mean-k">What the numbers show</p>
          <h3>Moderate discrimination, close calibration</h3>
          <p>
            AUROC 0.8352 with GCS and 0.8266 without: the model orders patients usefully and gets the
            ordering wrong often enough that it is not a classifier. Calibration is the better news — a
            ten-bin expected calibration error of 0.0112 means predicted and observed rates tracked
            within about one percentage point across the whole range, so the <em>size</em> of the number
            is more trustworthy than its rank order suggests.
          </p>
        </article>

        <article class="mean-card" data-reveal>
          <p class="mean-k">The GCS increment</p>
          <h3>+0.0086 AUROC, and what it may be made of</h3>
          <p>
            Adding the three components raised six-month AUROC by 0.0086 (95% CI 0.0054–0.0120) and
            28-day AUROC by 0.0138 (0.0090–0.0194) on the same holdout patients. An ICU-stay flag from
            the <code>icustays</code> table does not reproduce that gain at six months (+0.0014, CI
            −0.0012 to 0.0040), so it is not simply "was this patient sick enough for intensive care".
            That is the honest reading of what has been measured so far — and the label audit on the
            case-study page is the reason a further test is needed.
          </p>
        </article>

        <article class="mean-card mean-card-warn" data-reveal="1">
          <p class="mean-k">The open question</p>
          <h3>Part of that signal may be an artefact of the label</h3>
          <p>
            Dying in hospital and dying after discharge are different events. GCS is lowest in the
            patients closest to death in hospital, so if the outcome label mixes the two, GCS is
            unusually well placed to absorb the in-hospital signal. The prediction being tested is that
            the GCS increment shrinks in a survivors-to-discharge arm and that GCS predicts in-hospital
            death better than post-discharge death. Until that runs, the +0.0086 is a measurement
            awaiting a mechanism check, not a settled effect.
          </p>
        </article>
      </div>
    </section>

<!-- ===== provenance and limits ===== -->
    <section class="section wrap" id="provenance" aria-labelledby="prov-h">
      <SectionHeadInline
        id="prov-h"
        num="Provenance"
        title="Why you can trust <em>the numbers on this page.</em>"
        lede="A browser demo is only worth the evidence behind it. This one ships the exported ensembles, the metrics computed on the same holdout, and a script that re-checks the browser against XGBoost every time the model or the code changes."
      />

      <div class="prov-grid">
        <article class="panel prov" data-reveal>
          <p class="mean-k">The chain</p>
          <ol class="chain">
            <li><code>scripts/08_mimic_gcs_extraction.py</code> pulls the MIMIC-IV heart-failure cohort with the GCS components.</li>
            <li><code>scripts/09a_icu_stay_flags.py</code> adds an ICU-stay flag from <code>icustays</code>, independent of whether GCS was charted.</li>
            <li><code>scripts/09_mimic_native_gcs_retrain.py</code> fits both arms on a patient-grouped split and writes <code>results/mimic_gcs_run_log.md</code>.</li>
            <li><code>scripts/11_export_web_model.py</code> re-runs that protocol, asserts the reproduced AUROCs equal the logged ones, and exports the trees, medians, holdout calibration and a parity fixture to <code>{MODEL_URL}</code>.</li>
            <li><code>src/scripts/hf-risk-model.js</code> walks those trees in the browser, and <code>scripts/verify-web-model.mjs</code> re-checks it in Node.</li>
          </ol>
        </article>

        <article class="panel prov" data-reveal="1">
          <p class="mean-k">The checks that actually ran</p>
          <dl class="checks">
            <div><dt>Reproduced AUROCs</dt><dd>0.8266 and 0.8352, identical to the run log. The export aborts if they drift by more than 0.002.</dd></div>
            <div><dt>Browser against XGBoost</dt><dd>120 held-out patients re-evaluated from the exported trees alone: maximum probability difference 6.3&times;10<sup>-7</sup>.</dd></div>
            <div><dt>GCS attribution</dt><dd>Maximum difference from the Python computation 5.6&times;10<sup>-7</sup>, and the three shares sum to the exact span to 4.4&times;10<sup>-16</sup>.</dd></div>
            <div><dt>Float32 fidelity</dt><dd>The walker rounds threshold comparisons and leaf accumulation through float32, because XGBoost does. In float64 the traversal disagreed on 265 of 20,000 sampled tree decisions.</dd></div>
            <div><dt>Published metrics</dt><dd>Brier 0.1122 and ECE 0.0112 reproduce the values logged in the run log for the with-GCS arm.</dd></div>
          </dl>
          <pre class="prov-cmd"><code>node scripts/verify-web-model.mjs
python scripts/11_export_web_model.py</code></pre>
        </article>

        <article class="panel prov" data-reveal="2">
          <p class="mean-k">What it runs on, precisely</p>
          <p class="prov-p">
            XGBoost, 400 trees, depth 6, learning rate 0.05, subsample 0.8, seed 17. The split is
            <code>GroupShuffleSplit</code> at 80/20 grouped on <code>subject_id</code>, and the script asserts
            zero patient overlap before scoring — 8,006 of the 18,890 patients have more than one
            heart-failure admission, one of them 59, so a row-level split would have put the same person on
            both sides. Non-GCS missing values are filled with training-set medians computed on training
            rows only; GCS is never imputed.
          </p>
          <p class="prov-p">
            The model targets <strong>death within six months of the discharge date</strong>, which — as the
            label audit on the case-study page explains — includes deaths in hospital. That is a limitation
            of the label, not a detail, and it is the reason the mechanism test is the next piece of work
            rather than a footnote.
          </p>
        </article>
      </div>

