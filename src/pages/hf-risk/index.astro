    .hero-aside { position: sticky; top: 130px; border: 1px solid var(--rule); border-radius: 6px; background: var(--card); padding: clamp(20px, 2.4vw, 30px); display: flex; flex-direction: column; gap: 14px; }
    @media (max-width: 960px) { .hero { grid-template-columns: 1fr; } .hero-aside { position: static; } }

    /* ---- section heads inside HF page ---- */
