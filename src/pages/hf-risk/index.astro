---
import Layout from '../../components/Layout.astro';
import SectionHeadInline from '../../components/SectionHeadInline.astro';

const CASE_URL = '/hf-risk/';
const CASE_STORY_URL = '/hf-risk/tool/';
const GITHUB_URL = 'https://github.com/Nik85-png/hf-risk-heart-failure-ml';

// Hero stat strip data - ALL numbers post-audit
const heroStats = [
  { count: 2008, label: 'Zhang patients', subtitle: 'Heart-failure clinical records, Sichuan, China 2016–2019' },
  { count: 42990, label: 'MIMIC-IV admissions', subtitle: 'External transport set' },
  { count: 4, label: 'Outcomes', subtitle: '28-day mortality, 3-month mortality, 6-month mortality, 6-month readmission' },
  { count: 143, label: 'Clinical measurements', subtitle: 'After leakage audit removal' },
];

// Results - post-audit numbers only (no 0.819, 0.889, 0.922)
const results = [
  { value: '0.781', label: '28-day mortality', model: 'Random Forest' },
  { value: '0.839', label: '3-month mortality', model: 'Random Forest' },
  { value: '0.710', label: '6-month mortality', model: 'XGBoost' },
  { value: '0.650', label: '6-month readmission', model: 'XGBoost' },
];

// Audit data - verified post-audit numbers
const auditRows = [
  { horizon: '6-month mortality (primary)', before: '0.819', after: '0.710', delta: '−0.109', model: 'XGBoost', dir: 'down' },
  { horizon: '28-day mortality', before: '0.893', after: '0.781', delta: '−0.112', model: 'Random Forest', dir: 'down' },
  { horizon: '3-month mortality', before: '0.919', after: '0.839', delta: '−0.080', model: 'Random Forest', dir: 'down' },
  { horizon: '6-month readmission', before: '0.648', after: '0.650', delta: '+0.002', model: 'XGBoost', dir: 'up' },
];

// The outcome-label audit. Figures are stated with where they came from so a
// reader can tell a local recomputation from a MIMIC-side query.
const labelFindings = [
  {
    k: 'Day 0 is inside the outcome window',
    v: 'scripts/08_mimic_gcs_extraction.py, lines 77 and 80',
    body: 'The labels are built with DATE_DIFF(dod, dischtime, DAY) BETWEEN 0 AND 28 and BETWEEN 0 AND 180, so a death on the discharge day counts as a death after discharge. In MIMIC-IV the recorded date of death equals the discharge date for patients who died in hospital, so this is the normal case for them rather than an edge case.',
  },
  {
    k: 'In-hospital death was never identified',
    v: 'hospital_expire_flag: zero occurrences in the repository',
    body: 'No script, notebook or model in this project has ever read the in-hospital-death field. That means no arm of the analysis has counted those patients, let alone restricted an evaluation to survivors to discharge — so no number here has yet been computed on post-discharge death alone.',
  },
  {
    k: 'How large the overlap is',
    v: 'MIMIC-IV extract: 2,323 of 42,990 admissions ended in hospital',
    body: 'Those admissions are 53% of the 4,416 28-day positives and 25% of the 9,438 six-month positives. The published headline is therefore a mixture of in-hospital and post-discharge death, and any "after discharge" wording attached to it is wrong for those patients.',
  },
  {
    k: 'The dissertation cohort has the same defect',
    v: 'Zhang cohort cross-tabulation, 2,008 patients, recomputed locally',
    body: 'Eleven patients are recorded as dying in hospital; all eleven sit inside the 3-month and 6-month death labels and nine of the eleven inside the 28-day label, so 19–30% of the dissertation\'s positives are the wrong kind of death. Eleven in 2,008 (0.55%) is far below the usual heart-failure in-hospital mortality, so treat it as a floor on the exposure rather than a count. Two of the eleven are not labelled 28-day deaths at all, which is internally inconsistent and still needs resolving upstream.',
  },
];

// GCS extension data
const gcsRows = [
  { outcome: '28-day', model: 'Expanded baseline', features: '34', auroc: '0.8834', delta: 'Reference' },
  { outcome: '28-day', model: '+ GCS components', features: '37', auroc: '0.8972', delta: '+0.0138 (0.0090–0.0194)' },
  { outcome: '28-day', model: '+ ICU-stay flag', features: '35', auroc: '0.8915', delta: '+0.0080 (0.0037–0.0125)' },
  { outcome: '28-day', model: '+ ICU flag + GCS', features: '38', auroc: '0.9000', delta: '+0.0166 (0.0119–0.0220)' },
  { outcome: '6-month', model: 'Expanded baseline', features: '34', auroc: '0.8266', delta: 'Reference' },
  { outcome: '6-month', model: '+ GCS components', features: '37', auroc: '0.8352', delta: '+0.0086 (0.0054–0.0120)' },
  { outcome: '6-month', model: '+ ICU-stay flag', features: '35', auroc: '0.8280', delta: '+0.0014 (−0.0012–0.0040)', null: true },
  { outcome: '6-month', model: '+ ICU flag + GCS', features: '38', auroc: '0.8370', delta: '+0.0104 (0.0073–0.0136)' },
  { outcome: 'ICU only, 6-month', model: 'Baseline', features: '34', auroc: '0.8557', delta: 'Reference' },
  { outcome: 'ICU only, 6-month', model: '+ GCS components', features: '37', auroc: '0.8766', delta: '+0.0208 (0.0141–0.0274)', provisional: true },
];

// Drivers (post-audit, post-removal of leakage features)
const drivers = [
  { name: 'GCS (Glasgow Coma Scale)', w: '100%' },
  { name: 'Moderate–severe CKD', w: '88%' },
  { name: 'Mitral valve AMS', w: '78%' },
  { name: 'LV end-diastolic diameter', w: '72%' },
  { name: 'Liver disease', w: '66%' },
  { name: 'CHF history', w: '60%' },
  { name: 'Eye opening (GCS sub-score)', w: '54%' },
  { name: 'Reduced EF flag', w: '48%' },
  { name: 'Basophil ratio', w: '42%' },
  { name: 'Creatine kinase', w: '36%' },
];

const refs = [
  'Zhang et al. (2021). Heart failure clinical records. Scientific Data 8:46. doi:10.1038/s41597-021-00835-9',
  'Goldberger et al. (2000). PhysioBank, PhysioToolkit, and PhysioNet. Circulation 101(23), e215–e220.',
  'Johnson et al. MIMIC-IV. PhysioNet.',
  'Lundberg et al. (2020). SHAP. Nature Machine Intelligence.',
];

const jumpLinks = [
  ['#why', 'Why'],
  ['#the-plan', 'The plan'],
  ['#data', 'Data'],
  ['#audit', 'Audit'],
  ['#results', 'Results'],
  ['#survival', 'Survival'],
  ['#what-looks-at', 'What the model looks at'],
  ['#external', 'External validation'],
  ['#trust', 'Trust'],
  ['#tool', 'Tool'],
  ['#next', 'Next'],
  ['#method', 'Method'],
  ['#footer', 'Footer'],
];

const SITE = 'https://realnik.co.uk';
const schema = {
  '@type': 'ScholarlyArticle',
  '@id': `${SITE}/hf-risk/#article`,
  headline: 'HF-RISK — Predicting Heart Failure Outcomes with Machine Learning',
  name: 'HF-RISK — Predicting Heart Failure Outcomes with Machine Learning',
  description:
    'Leakage-audited machine-learning pipeline predicting 28-day, 3-month and 6-month mortality and 6-month readmission in 2,008 heart-failure patients: 0.710 AUROC at six months internally and 0.599 on 42,990 MIMIC-IV admissions without retraining. Extended in 2026 with a patient-grouped MIMIC-IV retrain testing whether Glasgow Coma Scale components add discrimination beyond a clinical baseline and beyond an ICU-stay flag.',
  url: `${SITE}/hf-risk/`,
  datePublished: '2026-03-20',
  dateModified: '2026-10-07',
  inLanguage: 'en-GB',
  author: { '@id': `${SITE}/#person` },
  about: [
    { '@type': 'MedicalCondition', name: 'Heart failure' },
    { '@type': 'Thing', name: 'Machine learning in healthcare' },
  ],
  keywords: [
    'heart failure prediction',
    'heart failure machine learning',
    'Glasgow Coma Scale mortality prediction',
    'leakage audit',
    'AUROC',
    'SHAP explainability',
    'XGBoost',
    'MIMIC-IV',
    'clinical predictive modelling',
  ],
  isPartOf: { '@id': `${SITE}/#website` },
};

---

<Layout
  title="HF-RISK — Predicting Heart Failure Outcomes with Machine Learning"
  description="MSc dissertation and 2026 extension: leakage-audited heart-failure outcome prediction on 2,008 patients, plus a patient-grouped MIMIC-IV retrain showing GCS components add +0.0138 AUROC at 28 days."
  ogType="article"
  ogImage="/hf-risk/assets/auroc_heatmap.png"
  keywords={[
    'heart failure prediction',
    'heart failure machine learning project',
    'heart failure mortality prediction',
    'MSc dissertation clinical machine learning',
    'leakage audit',
    'SHAP explainability',
    'MIMIC-IV external validation',
    'medical data analysis project',
  ]}
  schema={schema}
>
  <div class="hf">

    <!-- ===== warn strip ===== -->
    <div class="warn-strip" role="note">
      <span class="warn-dot" aria-hidden="true"></span>
      <p>
        Research prototype — not for clinical use. MSc dissertation project;
        results are internal validation and one external transportability
        check, not a clinical claim.
      </p>
    </div>

    <!-- ===== sub-nav ===== -->
    <nav class="hf-nav" aria-label="Case study sections">
      <div class="wrap hf-nav-inner">
        <a class="hf-brand" href="/hf-risk/">
          <span class="mark" aria-hidden="true">H</span>
          <span>HF-RISK</span>
        </a>
        <ul class="hf-links">
          <li><a href="#why">Why</a></li>
          <li><a href="#the-plan">The plan</a></li>
          <li><a href="#data">Data</a></li>
          <li><a href="#audit">Audit</a></li>
          <li><a href="#results">Results</a></li>
          <li><a href="#survival">Survival</a></li>
          <li><a href="#what-looks-at">What the model looks at</a></li>
          <li><a href="#external">External validation</a></li>
          <li><a href="#trust">Trust</a></li>
          <li><a href="#tool">Tool</a></li>
          <li><a href="#next">Next</a></li>
          <li><a href="#method">Method</a></li>
          <li><a href="#footer">Footer</a></li>
        </ul>
        <a class="hf-back" href="/projects/">&larr; All projects</a>
      </div>
    </nav>

    <!-- ===== hero ===== -->
    <header class="hero wrap">
      <div class="hero-main">
        <div class="eyebrow-row" data-reveal>
          <span>MSc Data Analytics</span>
          <span aria-hidden="true">/</span>
          <span>Heart Failure ML</span>
          <span aria-hidden="true">/</span>
          <span>2026</span>
        </div>
        <h1 data-reveal="1">Predicting heart<br />failure outcomes,<br /><em>honestly.</em></h1>
        <p class="deck" data-reveal="2">
          Five models, four outcome horizons, 2,008 patients — and a full
          leakage audit that cut the headline AUROC from 0.819 to 0.710
          before I believed a single digit of it. Then I retrained inside
          MIMIC-IV to test whether the neurological signal was real.
        </p>
        <dl class="hero-meta" data-reveal="3">
          <div><dt>Author</dt><dd>Nikunj Prajapati</dd></div>
          <div><dt>Institution</dt><dd>London Met.</dd></div>
          <div><dt>Course</dt><dd>MSc Data Analytics</dd></div>
          <div><dt>Cohort</dt><dd>Zhang / PhysioNet</dd></div>
          <div><dt>External set</dt><dd>MIMIC-IV (42,990)</dd></div>
          <div><dt>Updated</dt><dd>Oct 2026 · GCS extension</dd></div>
        </dl>
      </div>

      <aside class="hero-aside" data-reveal="2">
        <p class="aside-k">Jump to</p>
        <ul class="aside-spec">
          {jumpLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
        <a class="btn btn-ghost" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          View source <span class="arrow" aria-hidden="true">&nearr;</span>
        </a>
        <a class="btn btn-solid btn-attn" href={CASE_STORY_URL}>
          Try the tool <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </header>

    <!-- ===== stats ===== -->
    <div class="wrap">
      <div class="stat-strip" data-reveal>
        {heroStats.map((s, i) => (
          <div class="stat" data-reveal={String(i)}>
            <p class="k" data-count={s.count}>{s.count}</p>
            <p class="lbl">{s.label}</p>
            <p class="sub">{s.subtitle}</p>
          </div>
        ))}
        <p class="note"
          style="font-size: 11px; color: var(--fg-muted); margin-top: 8px;">
          4 outcomes · 143 clinical measurements · AUROC on held-out test set
        </p>
      </div>
    </div>

    <!-- ===== why ===== -->
    <section class="section wrap" id="why" aria-labelledby="why-h">
      <SectionHeadInline
        id="why-h"
        num="Why"
        title="Doctors still rely on a score from 2013. Can machine learning do better, and explain itself?"
        lede="Heart failure affects over 64 million people worldwide. After discharge, clinicians use risk scores such as MAGGIC, which ranks patients correctly about 74% of the time. These scores use a handful of variables and cannot explain individual predictions. This project asks whether machine learning on routine hospital data can do better, and show its reasoning."
      />
      <div class="why-grid">
        <div class="why-card">
          <p class="why-k">64 M</p>
          <p>people worldwide</p>
          <p>have heart failure</p>
        </div>
        <div class="why-card">
          <p class="why-k">~25%</p>
          <p>30-day readmission (US)</p>
          <p>of heart-failure patients</p>
        </div>
        <div class="why-card">
          <p class="why-k">~0.74</p>
          <p>MAGGIC C-index</p>
          <p>traditional score benchmark</p>
        </div>
      </div>
      <p class="why-lede" style="font-size: 13px; color: var(--fg-muted); margin: 24px 0 0; max-width: 68ch;">
        These scores use a handful of variables and cannot explain individual predictions.
        This project asks whether machine learning on routine hospital data can do better,
        and show its reasoning.
      </p>
    </section>

    <!-- ===== the-plan ===== -->
    <section class="section wrap" id="the-plan" aria-labelledby="the-plan-h">
      <SectionHeadInline
        id="the-plan-h"
        num="The plan"
        title="One study, two continents, and an audit"
        lede="Train on Zhang, explain it, audit it, then see whether it survives contact with a US hospital."
      />
      <div class="plan-flow">
        <div class="flow-node">Zhang data</div>
        <div class="flow-node">Models (5 × 4 outcomes)</div>
        <div class="flow-node">Survival analysis</div>
        <div class="flow-node">SHAP explanations</div>
        <div class="flow-node">MIMIC-IV test</div>
        <div class="flow-node">Audit & calibration</div>
        <div class="flow-node">Tool</div>
      </div>
    </section>

    <!-- ===== data ===== -->
    <section class="section wrap" id="data" aria-labelledby="data-h">
      <SectionHeadInline
        id="data-h"
        num="Data"
        title="Built on 2,008 patients, but only 11 of them died in the test set"
        lede="The Zhang cohort is 2,008 patients hospitalised with heart failure at Zigong Fourth People's Hospital in Sichuan, China (2016–2019), with outcomes from active follow-up. Deaths are rare: 57 patients (2.84%) died within 6 months, and only 11 of them fall in the 402-patient test set. That one fact shapes every number that follows."
      />
      <div class="data-visual">
        <div class="outcome-rates">
          <h4>Outcome rates</h4>
          <ul>
            <li>28-day death: 37 (1.84%)</li>
            <li>3-month death: 42 (2.09%)</li>
            <li>6-month death: 57 (2.84%)</li>
            <li>6-month readmission: 773 (38.5%)</li>
          </ul>
        </div>
        <div class="table1">
          <h4>Key characteristics</h4>
          <table>
            <thead>
              <tr><th>Variable</th><th>Value</th></tr>
            </thead>
            <tbody>
              <tr><td>BNP median</td><td>753 pg/mL [IQR 304–1,739]</td></tr>
              <tr><td>LVEF recorded</td><td>635 patients (32%), 68% missing</td></tr>
              <tr><td>NYHA class III</td><td>52% most common</td></tr>
              <tr><td>Age band (69,79]</td><td>36% most common</td></tr>
            </tbody>
          </table>
        </div>
        <details class="details-ac">
          <summary>Details accordion: cohort split</summary>
          <p>
            Train/test split: 1,606 / 402; deaths in train/test per outcome (28d 31/6, 3m 35/7, 6m 46/11);
            11 variables dropped for over 80% missing; 2 near-zero-variance variables dropped;
            three-tier imputation (median under 10% missing, MICE 10–80%); SMOTE only inside CV training folds.
          </p>
        </details>
        <figure class="fig" data-reveal data-title="Outcome class balance" data-cap="Zhang cohort: 28-day 37 deaths, 3-month 42, 6-month 57, and 773 six-month readmissions.">
          <img src="/hf-risk/assets/outcome_class_balance.png"
            alt="Outcome class balance: 28-day 37 deaths, 3-month 42 deaths, 6-month 57 deaths, 6-month readmission 773 events"
            width="1908" height="495" loading="lazy" />
          <figcaption class="fig-cap">Outcome class balance from Zhang cohort</figcaption>
        </figure>
      </section>

    <!-- ===== audit ===== -->
    <section class="section wrap" id="audit" aria-labelledby="audit-h">
      <SectionHeadInline
        id="audit-h"
        num="Audit"
        title="I audited my own model. The headline number fell from 0.82 to 0.71."
        lede="My first pipeline scored AUROC 0.819 for 6-month mortality. With only 11 deaths in the test set that was too good, so I went looking for ways it could be cheating. After the fix, the honest figure is 0.710. Every number below comes from the audited pipeline."
      />
      <div class="audit-contrast">
        <div class="audit-before">
          <p class="audit-k">Before audit</p>
          <p class="audit-num">0.819</p>
        </div>
        <div class="audit-arrow" aria-hidden="true">&rarr;</div>
        <div class="audit-after">
          <p class="audit-k">After audit</p>
          <p class="audit-num">0.710</p>
        </div>
      </div>
      <div class="audit-table">
        <header class="audit-row audit-head-row">
          <span>Outcome horizon</span><span>Before</span><span>After</span><span>&Delta;</span><span>Model</span>
        </header>
        {auditRows.map((r) => (
          <div class="audit-row">
            <span>{r.horizon}</span>
            <span class="before">{r.before}</span>
            <span class="after">{r.after}</span>
            <span><span class={`delta-pill ${r.dir}`}>{r.delta}</span></span>
            <span>{r.model}</span>
          </div>
        ))}
      </div>
      <div class="removed">
        <p class="block-k">Removed as leakage</p>
        <ul class="tag-row">
          <li class="tag">Unnamed: 0</li>
          <li class="tag">inpatient.number</li>
          <li class="tag">dischargeDay</li>
          <li class="tag">outcome.during.hospitalization</li>
          <li class="tag">readmission & emergency-return timing proxies</li>
        </ul>
        <p class="removed-note">
          Every removed feature was available only after the outcome was already decided —
          perfect hindsight, zero clinical value.
        </p>
      </div>
      <div class="still-checked">
        <p class="block-k">Two discharge variables, discharge destination and discharge department, are still among the 143 features.</p>
        <p>Their effect has not yet been measured. Strongly recommend running the ablation before launch.</p>
      </div>

      <div class="label-audit">
        <p class="block-k">A second audit — the outcome label itself</p>
        <h3>Re-deriving the labels for the GCS extension exposed a defect in this project's own numbers.</h3>
        <p class="label-audit-lede">
          The models target "death within six months of the discharge date". Re-deriving that label meant
          reading the extraction SQL line by line, and what came out of it is not a GCS result: it is a
          labelling defect that reaches the published headlines and the dissertation's own cohort. It is
          reported here rather than quietly patched.
        </p>

        <div class="find-grid">
          {labelFindings.map((f, i) => (
            <article class="find" data-reveal={String(Math.min(i % 4 + 1, 4))}>
              <p class="find-k">{f.k}</p>
              <p class="find-v"><code>{f.v}</code></p>
              <p class="find-b">{f.body}</p>
            </article>
          ))}
        </div>

        <div class="zhang">
          <div class="zhang-head">
            <h4>The dissertation cohort, cross-tabulated</h4>
            <p>
              2,008 patients from the Zhang / PhysioNet heart-failure cohort, whose records carry both an
              in-hospital outcome field and the death labels the dissertation was fitted on. Recomputed
              from the local file in this project.
            </p>
          </div>
          <div class="gcs-table-wrap">
            <table class="gcs-table">
              <caption>
                In-hospital outcome against the labels used for modelling. Every in-hospital death is
                inside the 3-month and 6-month labels.
              </caption>
              <thead>
                <tr>
                  <th scope="col">Recorded in-hospital outcome</th>
                  <th scope="col">Patients</th>
                  <th scope="col">Labelled 28-day death</th>
                  <th scope="col">Labelled 3-month death</th>
                  <th scope="col">Labelled 6-month death</th>
                </tr>
              </thead>
              <tbody>
                <tr><th scope="row">Alive</th><td>1,890</td><td>8</td><td>11</td><td>26</td></tr>
                <tr class="is-flag"><th scope="row">Died in hospital</th><td>11</td><td>9</td><td>11</td><td>11</td></tr>
                <tr><th scope="row">Discharge against advice</th><td>107</td><td>20</td><td>20</td><td>20</td></tr>
                <tr class="is-total"><th scope="row">Total positives</th><td>2,008</td><td>37</td><td>42</td><td>57</td></tr>
              </tbody>
            </table>
          </div>
          <ul class="zhang-notes">
            <li><strong>19–30% of each outcome's positives are in-hospital deaths.</strong> All eleven are inside the 3-month and 6-month labels; nine of the eleven are inside the 28-day label.</li>
            <li><strong>Eleven is a floor, not a count.</strong> 0.55% in-hospital mortality is implausibly low for heart-failure admissions against the usual 4–8%, so the field may under-record or the cohort may have excluded dying patients by construction.</li>
            <li><strong>Two rows are internally inconsistent.</strong> Two patients recorded as dying in hospital are not labelled 28-day deaths, which is not possible if the labels mean what they say. That points at a defect upstream that has not yet been located.</li>
            <li><strong>Events per variable.</strong> The dissertation fitted 143 features to 37, 42 and 57 events. Cross-validated AUROC standard deviations ran 0.129–0.165, and a Random Forest reported 0.9315 at 28 days with sensitivity 0.195 — strong ranking, almost no detection. Those point estimates need bootstrapped optimism correction before they are quoted again.</li>
          </ul>
        </div>

        <div class="next-grid">
          <article class="next" data-reveal>
            <p class="mean-k">What this does not change</p>
            <ul>
              <li>The patient-grouped split. Every MIMIC number on this site already used it, with zero patient overlap asserted before scoring.</li>
              <li>The GCS extraction itself: GCS is left as a genuine missing value rather than imputed, <code>gcs_total</code> is excluded as a fabricated placeholder, and verbal response 0 is treated as untestable.</li>
              <li>The direction of the leakage-audit result. If anything, a label that includes in-hospital deaths makes the audited numbers look better than they are.</li>
            </ul>
          </article>
          <article class="next" data-reveal="1">
            <p class="mean-k">What is now in progress</p>
            <ul>
              <li>A single re-extraction carrying <code>hospital_expire_flag</code> and <code>deathtime</code>, with the old and corrected label columns side by side so every arm reads from one file.</li>
              <li>A four-rung ladder — row-level split with old labels, grouped split with old labels, grouped split with day 0 excluded, grouped split restricted to survivors to discharge — to separate patient-overlap inflation from outcome-window inflation.</li>
              <li>The mechanism test: the GCS increment for <em>in-hospital</em> death against post-discharge death.</li>
              <li>Competing risks rather than survivor-only exclusion, so the whole cohort stays in the analysis.</li>
              <li>A variable-availability statement, because part of the baseline is derived from ICD codes that are finalised after discharge.</li>
            </ul>
          </article>
        </div>

        <aside class="correction" role="note" data-reveal>
          <p class="correction-k">Correction, in the open</p>
          <p>
            The affected numbers are already public in four places: this site, the CV, the dissertation and
            the repository README. All four will move together once the corrected extract exists, and this
            page will carry the note rather than a silent edit. A discrepancy between a paper and the site
            describing it would be a far worse outcome than lower numbers.
          </p>
