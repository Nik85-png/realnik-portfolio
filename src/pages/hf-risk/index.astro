  <!-- ===== lightbox behaviour ===== -->
  <script>
    // Click (or keyboard-activate) any .fig to view it large; close with the
    // button, the scrim, or Escape. The lightbox is hidden in CSS by default,
    // so this only enhances pages that opted into figure markup.
    (() => {
      const lb = document.getElementById('lightbox');
      if (!lb) return;

      const img = document.getElementById('lbImg');
      const title = document.getElementById('lbTitle');
      const meta = document.getElementById('lbMeta');
      const closeBtn = lb.querySelector('.lb-close');
      let lastFocus = null;

      const open = (fig) => {
        const source = fig.querySelector('img');
        if (!source) return;
        img.src = source.currentSrc || source.src;
        img.alt = source.alt || '';
        title.textContent = fig.dataset.title || '';
        meta.textContent = fig.dataset.cap || '';
        title.hidden = !title.textContent;
        meta.hidden = !meta.textContent;
        lastFocus = document.activeElement;
        lb.classList.add('is-open');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        closeBtn.focus();
      };

      const close = () => {
        if (!lb.classList.contains('is-open')) return;
        lb.classList.remove('is-open');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        img.src = '';
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      };

      document.querySelectorAll('.fig').forEach((fig) => {
        const source = fig.querySelector('img');
        if (!source) return;
        fig.setAttribute('role', 'button');
        fig.setAttribute('tabindex', '0');
        fig.setAttribute('aria-label', `Expand figure: ${fig.dataset.title || source.alt || 'figure'}`);
        fig.addEventListener('click', () => open(fig));
        fig.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            open(fig);
          }
        });
      });

      lb.querySelectorAll('[data-lb-close]').forEach((el) => el.addEventListener('click', close));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
    })();
  </script>

