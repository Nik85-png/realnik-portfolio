---
import Layout from '../../components/Layout.astro';
import SectionHeadInline from '../../components/SectionHeadInline.astro';

const TOOL_URL = 'https://hf-risk-heart-failure-ml.onrender.com/';
const GITHUB_URL = 'https://github.com/Nik85-png/hf-risk-heart-failure-ml';

const auditRows = [
  { horizon: '28-day mortality', before: '0.893', after: '0.781', delta: '−0.112', model: 'Random Forest', dir: 'down' },
  { horizon: '3-month mortality', before: '0.919', after: '0.839', delta: '−0.080', model: 'Random Forest', dir: 'down' },
  { horizon: '6-month mortality (primary)', before: '0.819', after: '0.710', delta: '−0.109', model: 'XGBoost', dir: 'down' },
  { horizon: '6-month readmission', before: '0.648', after: '0.650', delta: '+0.002', model: 'XGBoost', dir: 'up' },
];

const results = [
  { value: '0.781', label: '28-day mortality', model: 'Random Forest', width: '78.1%' },
  { value: '0.839', label: '3-month mortality', model: 'Random Forest', width: '83.9%' },
  { value: '0.710', label: '6-month mortality', model: 'XGBoost', width: '71%' },
  { value: '0.650', label: '6-month readmission', model: 'XGBoost', width: '65%' },
];

// MIMIC-native GCS retrain (Sept 2026). Paired AUROC differences on the same
// holdout patients; `null: true` marks a confidence interval crossing zero.
const gcsRows = [
  { outcome: '28-day', model: 'Expanded baseline', features: '34', auroc: '0.8834', delta: 'Reference' },
  { outcome: '28-day', model: '+ GCS components', features: '37', auroc: '0.8972', delta: '+0.0138 (0.0090–0.0194)' },
  { outcome: '28-day', model: '+ ICU-stay flag', features: '35', auroc: '0.8915', delta: '+0.0080 (0.0037–0.0125)' },
  { outcome: '28-day', model: '+ ICU flag + GCS', features: '38', auroc: '0.9000', delta: '+0.0166 (0.0119–0.0220)' },
  { outcome: '6-month', model: 'Expanded baseline', features: '34', auroc: '0.8266', delta: 'Reference' },
  { outcome: '6-month', model: '+ GCS components', features: '37', auroc: '0.8352', delta: '+0.0086 (0.0054–0.0120)' },
  { outcome: '6-month', model: '+ ICU-stay flag', features: '35', auroc: '0.8280', delta: '+0.0014 (−0.0012–0.0040)', null: true },
  { outcome: '6-month', model: '+ ICU flag + GCS', features: '38', auroc: '0.8370', delta: '+0.0104 (0.0073–0.0136)' },
  { outcome: 'ICU only, 6-month', model: 'Baseline', features: '34', auroc: '0.8557', delta: 'Reference' },
  { outcome: 'ICU only, 6-month', model: '+ GCS components', features: '37', auroc: '0.8766', delta: '+0.0208 (0.0141–0.0274)', provisional: true },
];

const gcsNotes = [
  {
    k: 'Why the split matters',
    body: '8,006 of the 18,890 patients have more than one heart-failure admission (one has 59). A row-level split would scatter the same person across train and test and inflate every score. Every number above comes from a grouped 80/20 split on subject_id with zero patient overlap asserted before scoring.',
  },
  {
    k: 'GCS is left missing, never imputed',
    body: 'GCS is charted for 12,083 of 42,990 admissions (28.1%) — the rest were never assessed, so the field is left empty and XGBoost handles the NaN natively. gcs_total is excluded as a feature: for intubated patients it reads 15 regardless of the components. Treating an untested patient as a normal score would fabricate a clinical observation.',
  },
  {
    k: 'The ICU control',
    body: 'The ICU-stay flag comes from the icustays table, independently of whether GCS was charted. At six months the flag alone is a null result (+0.0014, CI crossing zero) while GCS still adds +0.0104 on top of it — so the gain is not simply “was this patient sick enough for intensive care”.',
  },
];

const drivers = [
  { name: 'GCS (Glasgow Coma Scale)', w: '100%' },
  { name: 'Moderate–severe CKD', w: '88%' },
  { name: 'Mitral valve AMS', w: '78%' },
  { name: 'LV end-diastolic diameter', w: '72%' },
  { name: 'Liver disease', w: '66%' },
  { name: 'CHF history', w: '60%' },
  { name: 'Eye opening (GCS sub-score)', w: '54%' },
  { name: 'Reduced EF flag', w: '48%' },
  { name: 'Basophil ratio', w: '42%' },
  { name: 'Creatine kinase', w: '36%' },
];

const figures = [
  // w/h are the real pixel sizes of each PNG, emitted as width/height so the
  // browser reserves the right box before the image loads (no layout shift).
  { src: 'calibration_curves.png', title: 'Calibration curves', cap: 'Predicted vs observed across deciles — Brier 0.027, ECE 0.023.', w: 1428, h: 642 },
  { src: 'dca_curves.png', title: 'Decision curve analysis', cap: 'Net benefit across thresholds vs treat-all / treat-none.', w: 1428, h: 642 },
  { src: 'auroc_heatmap.png', title: 'AUROC heatmap', cap: 'All five models × four horizons after the leakage audit.', w: 1123, h: 468 },
  { src: 'roc_curves.png', title: 'ROC curves', cap: 'Held-out Zhang cohort, four horizons.', w: 2388, h: 617 },
  { src: 'km_by_nyha.png', title: 'Kaplan–Meier by NYHA class', cap: 'Survival separation across NYHA I–IV.', w: 1188, h: 707 },
  { src: 'cox_forest_plot.png', title: 'Cox forest plot', cap: 'Hazard ratios with 95% CIs for the final predictor set.', w: 1187, h: 827 },
  { src: 'subgroup_ckd.png', title: 'Subgroup: CKD status', cap: 'AUROC split by chronic kidney disease.', w: 1067, h: 456 },
  { src: 'subgroup_gender.png', title: 'Subgroup: gender', cap: 'AUROC split by gender.', w: 1067, h: 456 },
  { src: 'shap_bar.png', title: 'SHAP bar — mean |SHAP|', cap: 'Global feature importance after the audit.', w: 1188, h: 827 },
];

const refs = [
  'Zhang et al. (2021). Heart failure clinical records. Scientific Data 8:46. doi:10.1038/s41597-021-00835-9',
  'Goldberger et al. (2000). PhysioBank, PhysioToolkit, and PhysioNet. Circulation 101(23), e215–e220.',
  'Johnson et al. MIMIC-IV. PhysioNet.',
  'Chicco & Jurman (2020). The advantages of the Matthews correlation coefficient. BMC Med Inform Decis Mak 20:16 — baseline AUC ≈ 0.73.',
  'Lundberg et al. (2020). SHAP. Nature Machine Intelligence.',
];

const jumpLinks = [
  ['#tool', 'The live prototype'],
  ['#audit', 'The leakage audit'],
  ['#results', 'Results'],
  ['#gcs', 'GCS extension'],
  ['#shap', 'SHAP drivers'],
  ['#external', 'MIMIC-IV transport'],
  ['#evaluation', 'Calibration & DCA'],
];

// Structured data: marks this page as a scholarly article about heart-failure
// outcome prediction so search engines can connect the work to the topic.
const SITE = 'https://realnik.co.uk';
const schema = {
  '@type': 'ScholarlyArticle',
  '@id': `${SITE}/hf-risk/#article`,
  headline: 'HF-RISK — Predicting Heart Failure Outcomes with Machine Learning',
  name: 'HF-RISK — Predicting Heart Failure Outcomes with Machine Learning',
  description:
    'Leakage-audited machine-learning pipeline predicting 28-day, 3-month and 6-month mortality and 6-month readmission in 2,008 heart-failure patients: 0.710 AUROC at six months internally and 0.599 on 42,990 MIMIC-IV admissions without retraining. Extended in 2026 with a patient-grouped MIMIC-IV retrain testing whether Glasgow Coma Scale components add discrimination beyond a clinical baseline and beyond an ICU-stay flag.',
  url: `${SITE}/hf-risk/`,
  datePublished: '2026-03-20',
  dateModified: '2026-10-07',
  inLanguage: 'en-GB',
  author: { '@id': `${SITE}/#person` },
  about: [
    { '@type': 'MedicalCondition', name: 'Heart failure' },
    { '@type': 'Thing', name: 'Machine learning in healthcare' },
  ],
  keywords: [
    'heart failure prediction',
    'heart failure machine learning',
    'Glasgow Coma Scale mortality prediction',
    'leakage audit',
    'AUROC',
    'SHAP explainability',
    'XGBoost',
    'MIMIC-IV',
    'clinical predictive modelling',
  ],
  isPartOf: { '@id': `${SITE}/#website` },
};
---

<Layout
  title="HF-RISK — Heart Failure Prediction with ML"
  description="MSc dissertation and 2026 extension: leakage-audited heart-failure outcome prediction on 2,008 patients, plus a patient-grouped MIMIC-IV retrain showing GCS components add +0.0138 AUROC at 28 days."
  ogType="article"
  ogImage="/hf-risk/assets/auroc_heatmap.png"
  keywords={[
    'heart failure prediction',
    'heart failure machine learning project',
    'heart failure mortality prediction',
    'MSc dissertation clinical machine learning',
    'leakage audit',
    'SHAP explainability',
    'MIMIC-IV external validation',
    'medical data analysis project',
  ]}
  schema={schema}
>
  <div class="hf">
    <!-- ===== warn strip ===== -->
    <div class="warn-strip" role="note">
      <span class="warn-dot" aria-hidden="true"></span>
      <p>
        Research prototype — not for clinical use. MSc dissertation project;
        results are internal validation and one external transportability
        check, not a clinical claim.
      </p>
    </div>

    <!-- ===== sub-nav ===== -->
    <nav class="hf-nav" aria-label="Case study sections">
      <div class="wrap hf-nav-inner">
        <a class="hf-brand" href="/hf-risk/">
          <span class="mark" aria-hidden="true">H</span>
          <span>HF-RISK</span>
        </a>
        <ul class="hf-links">
          <li><a href="#tool">Tool</a></li>
          <li><a href="#audit">Audit</a></li>
          <li><a href="#results">Results</a></li>
          <li><a href="#gcs">GCS</a></li>
          <li><a href="#shap">SHAP</a></li>
          <li><a href="#external">External</a></li>
          <li><a href="#evaluation">Evaluation</a></li>
        </ul>
        <a class="hf-back" href="/projects/">&larr; All projects</a>
      </div>
    </nav>

    <!-- ===== hero ===== -->
    <header class="hero wrap">
      <div class="hero-main">
        <div class="eyebrow-row" data-reveal>
          <span>MSc Data Analytics</span>
          <span aria-hidden="true">/</span>
          <span>Heart Failure ML</span>
          <span aria-hidden="true">/</span>
          <span>2026</span>
        </div>
        <h1 data-reveal="1">Predicting heart<br />failure outcomes,<br /><em>honestly.</em></h1>
        <p class="deck" data-reveal="2">
          Five models, four outcome horizons, 2,008 patients — and a full
          leakage audit that cut the headline AUROC from 0.819 to 0.710
          before I believed a single digit of it. Then I retrained inside
          MIMIC-IV to test whether the neurological signal was real.
        </p>
        <dl class="hero-meta" data-reveal="3">
          <div><dt>Author</dt><dd>Nikunj Prajapati</dd></div>
          <div><dt>Institution</dt><dd>London Met.</dd></div>
          <div><dt>Course</dt><dd>MSc Data Analytics</dd></div>
          <div><dt>Cohort</dt><dd>Zhang / PhysioNet</dd></div>
          <div><dt>External set</dt><dd>MIMIC-IV (42,990)</dd></div>
          <div><dt>Updated</dt><dd>Oct 2026 · GCS extension</dd></div>
        </dl>
      </div>

      <aside class="hero-aside" data-reveal="2">
        <p class="aside-k">Jump to</p>
        <ul class="aside-spec">
          {jumpLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
        <a class="btn btn-ghost" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          View source <span class="arrow" aria-hidden="true">&nearr;</span>
        </a>
        <a class="btn btn-solid" href={TOOL_URL} target="_blank" rel="noopener noreferrer">
          Try the tool <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </header>

    <!-- ===== stats ===== -->
    <div class="wrap">
      <div class="stat-strip">
        <div class="stat" data-reveal><p class="k" data-count="2008">0</p><p class="lbl">Zhang patients</p><p class="sub">Heart-failure clinical records</p></div>
        <div class="stat" data-reveal="1"><p class="k" data-count="143">0</p><p class="lbl">Final predictors</p><p class="sub">After the leakage audit</p></div>
        <div class="stat" data-reveal="2"><p class="k" data-count="42990">0</p><p class="lbl">MIMIC-IV admissions</p><p class="sub">External transport set</p></div>
        <div class="stat" data-reveal="3"><p class="k" data-count="0.0138" data-decimals="4" data-prefix="+">0</p><p class="lbl">AUROC from GCS</p><p class="sub">MIMIC-IV, 28-day, grouped split</p></div>
      </div>
    </div>

    <!-- ===== tool ===== -->
    <section class="section wrap" id="tool" aria-labelledby="tool-h">
      <SectionHeadInline id="tool-h" num="The live prototype" title="Now runs the <em>real models.</em>" lede="The deployed Streamlit app serves the audited pipeline — same 143 predictors, same thresholds, with a research-only framing." />

      <div class="tool-wrap">
        <div class="tool-panel" data-reveal>
          <div class="tool-chrome">
            <span class="chrome-dot"></span><span class="chrome-dot"></span><span class="chrome-dot"></span>
            <span class="chrome-title">hf-risk &mdash; render service &mdash; live inference</span>
            <span class="tool-tag live" id="toolTag">Checking&hellip;</span>
          </div>

          <div class="tool-launch">
            <h3>Launch the live HF-RISK tool in its own workspace</h3>
            <div class="tool-launch-grid">
              <div class="mini"><p class="mini-k">Real inference</p><p>Same pipeline as the dissertation.</p></div>
              <div class="mini"><p class="mini-k">Live SHAP</p><p>Per-patient explanations on demand.</p></div>
              <div class="mini"><p class="mini-k">Research-safe</p><p>Framed as prototype, never advice.</p></div>
            </div>
            <p class="tool-embed-note">
              <a class="tool-primary-cta" href={TOOL_URL} target="_blank" rel="noopener noreferrer" id="toolCta">
                Open the live HF-RISK tool &rarr;
              </a>
              <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">View source on GitHub</a>
            </p>
          </div>
        </div>

        <aside class="tool-aside" data-reveal="1">
          <ul class="tool-bullets">
            <li>Four horizons: 28-day, 3-month, 6-month mortality; 6-month readmission</li>
            <li>143 audited predictors per admission</li>
            <li>SHAP explanation for every prediction</li>
            <li>Research-only framing throughout</li>
          </ul>
          <div class="safety-note" role="note">
            <p><strong>Research-only.</strong> Not validated for clinical use. Never a substitute for a clinician's judgement.</p>
          </div>
          <p class="local-run">Run it yourself</p>
          <pre><code>git clone https://github.com/Nik85-png/hf-risk-heart-failure-ml
cd hf-risk-heart-failure-ml
pip install -r requirements.txt
python app.py</code></pre>
          <div class="tool-row">
            <a class="btn btn-ghost" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="btn btn-solid" href={TOOL_URL} target="_blank" rel="noopener noreferrer">Open live tool</a>
          </div>
        </aside>
      </div>
    </section>

    <!-- ===== audit ===== -->
    <section class="section wrap" id="audit" aria-labelledby="audit-h">
      <SectionHeadInline id="audit-h" num="The audit" title="Higher AUROC isn't better <em>if it's not honest.</em>" lede="An earlier pass reached 0.819 at six months. The audit found features that leak the future — and the honest number is 0.710 internal, 0.599 external." />

      <div class="audit-head" data-reveal>
        <div class="audit-big">
          <p class="audit-k">Before audit</p>
          <p class="audit-num before">0.819</p>
        </div>
        <div class="audit-arrow" aria-hidden="true">&rarr;</div>
        <div class="audit-big">
          <p class="audit-k">After audit</p>
          <p class="audit-num after">0.710</p>
        </div>
      </div>

      <div class="audit-table" data-reveal="1">
        <header class="audit-row audit-head-row">
          <span>Outcome horizon</span><span>Before</span><span>After</span><span>&Delta;</span><span>Model</span>
        </header>
        {auditRows.map((r) => (
          <div class="audit-row">
            <span>{r.horizon}</span>
            <span class="before">{r.before}</span>
            <span class="after">{r.after}</span>
            <span><span class={`delta-pill ${r.dir}`}>{r.delta}</span></span>
            <span>{r.model}</span>
          </div>
        ))}
      </div>

      <div class="removed" data-reveal="2">
        <p class="block-k">Removed as leakage</p>
        <ul class="tag-row">
          <li class="tag">Unnamed: 0</li>
          <li class="tag">inpatient.number</li>
          <li class="tag">dischargeDay</li>
          <li class="tag">outcome.during.hospitalization</li>
          <li class="tag">readmission &amp; emergency-return timing proxies</li>
        </ul>
        <p class="removed-note">
          Every removed feature was available only after the outcome was
          already decided — perfect hindsight, zero clinical value.
        </p>
      </div>
    </section>

    <!-- ===== results ===== -->
    <section class="section wrap" id="results" aria-labelledby="results-h">
      <SectionHeadInline id="results-h" num="Results" title="The numbers that <em>survive scrutiny.</em>" lede="Held-out Zhang cohort, four horizons, two model families." />

      <div class="results-grid">
        {results.map((r, i) => (
          <div class="result-card" data-reveal={String(Math.min(i, 4))}>
            <p class="result-num">{r.value}</p>
            <div class="result-bar" role="img" aria-label={`AUROC ${r.value}`}>
              <span style={`width:${r.width}`}></span>
            </div>
            <p class="result-lbl">{r.label}</p>
            <p class="result-model">{r.model}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== gcs extension ===== -->
    <section class="section wrap" id="gcs" aria-labelledby="gcs-h">
      <SectionHeadInline
        id="gcs-h"
        num="2026 extension · GCS"
        title="Does GCS add anything <em>beyond an ICU stay?</em>"
        lede="GCS topped the Zhang SHAP ranking, so I retrained inside MIMIC-IV — 42,990 admissions from 18,890 patients, grouped by patient — and tested the components against a real ICU-stay control."
      />

      <div class="gcs-hero">
        <div class="gcs-big" data-reveal>
          <p class="gcs-k">28-day mortality</p>
          <p class="gcs-num">0.8834 <span aria-hidden="true">&rarr;</span> 0.8972</p>
          <p class="gcs-sub">+0.0138 AUROC · 95% CI 0.0090–0.0194</p>
        </div>
        <div class="gcs-big" data-reveal="1">
          <p class="gcs-k">6-month mortality</p>
          <p class="gcs-num">0.8266 <span aria-hidden="true">&rarr;</span> 0.8352</p>
          <p class="gcs-sub">+0.0086 AUROC · 95% CI 0.0054–0.0120</p>
        </div>
        <div class="gcs-big" data-reveal="2">
          <p class="gcs-k">ICU subgroup, 6-month <em>descriptive</em></p>
          <p class="gcs-num">0.8557 <span aria-hidden="true">&rarr;</span> 0.8766</p>
          <p class="gcs-sub">+0.0208 AUROC · 95% CI 0.0141–0.0274</p>
        </div>
      </div>

      <div class="gcs-table-wrap" data-reveal="1">
        <table class="gcs-table">
          <caption>
            Paired AUROC differences measured on the same 8,749-admission
            holdout. Baseline = 34 clinical features; GCS adds eye opening,
            verbal response and movement.
          </caption>
          <thead>
            <tr>
              <th scope="col">Outcome</th>
              <th scope="col">Model</th>
              <th scope="col">Features</th>
              <th scope="col">Test AUROC</th>
              <th scope="col">&Delta; vs baseline (95% CI)</th>
            </tr>
          </thead>
          <tbody>
            {gcsRows.map((r) => (
              <tr class={r.null ? 'is-null' : r.provisional ? 'is-provisional' : undefined}>
                <th scope="row">{r.outcome}</th>
                <td>{r.model}</td>
                <td class="num">{r.features}</td>
                <td class="num">{r.auroc}</td>
                <td class="num">{r.delta}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="gcs-legend">
          Shaded rows: a confidence interval crossing zero (no detectable
          improvement at this sample size), and the ICU-subgroup result, which
          uses a single split rather than five-fold cross-validation.
        </p>
      </div>

      <div class="gcs-notes">
        {gcsNotes.map((n, i) => (
          <div class="panel" data-reveal={String(Math.min(i, 3)) || undefined}>
            <p class="block-k">{n.k}</p>
            <p class="panel-p">{n.body}</p>
          </div>
        ))}
      </div>

      <aside class="gcs-caveat" data-reveal="1">
        <p class="block-k">What this does not establish</p>
        <ul class="caveat-list">
          <li>
            One cohort, one extraction: admissions with an ICD-10 I50*
            diagnosis code only. ICD-9 428* admissions are outside this cohort.
          </li>
          <li>
            The ICU subgroup is selected on severity — ICU admission is itself
            caused by how sick the patient was — so its AUROC and its +0.0208
            increment are descriptive and must not be compared with the
            full-cohort numbers.
          </li>
          <li>
            The outcome windows start on the discharge date, so patients who
            died in hospital are counted as post-discharge deaths: 2,323 of the
            4,416 28-day positives (53%). It is a known label-definition problem,
            recorded in the repository and being corrected in the next revision —
            the increments above are within-analysis comparisons, not
            absolute performance claims.
          </li>
          <li>
            No external validation of these MIMIC-native models has been done,
            and nothing here is a clinical claim.
          </li>
        </ul>
      </aside>

      <div class="gcs-figs">
        <figure class="fig zoom" data-reveal data-src="shap_bar_icu_only.png" data-title="SHAP bar — ICU-only cohort" data-cap="Verbal response ranks first of 37 features in the ICU-only six-month model; movement sixth and eye opening seventh.">
          <img src="/hf-risk/assets/shap_bar_icu_only.png" alt="SHAP bar chart of mean absolute SHAP values for the ICU-only MIMIC-IV six-month model" width="1287" height="765" loading="lazy" />
          <figcaption class="hover-cap"><span class="plus" aria-hidden="true">+</span> Click to expand</figcaption>
        </figure>
        <figure class="fig zoom" data-reveal="1" data-src="shap_beeswarm_icu_only.png" data-title="SHAP beeswarm — ICU-only cohort" data-cap="One dot per admission; colour is the feature value. Verbal response sits at the top of this model.">
          <img src="/hf-risk/assets/shap_beeswarm_icu_only.png" alt="SHAP beeswarm plot for the ICU-only MIMIC-IV six-month model" width="994" height="960" loading="lazy" />
          <figcaption class="hover-cap"><span class="plus" aria-hidden="true">+</span> Click to expand</figcaption>
        </figure>
        <figure class="fig zoom" data-reveal="2" data-src="shap_cross_cohort_ranks.png" data-title="Cross-cohort feature ranks" data-cap="Zhang top-20 vs MIMIC-IV ranks. Only seven features overlap and the Zhang table is truncated, so the comparison stays qualitative.">
          <img src="/hf-risk/assets/shap_cross_cohort_ranks.png" alt="Scatter of feature rank positions in the Zhang and MIMIC-IV SHAP rankings" width="1672" height="766" loading="lazy" />
          <figcaption class="hover-cap"><span class="plus" aria-hidden="true">+</span> Click to expand</figcaption>
        </figure>
      </div>
    </section>

    <!-- ===== process ===== -->
    <section class="section wrap" id="process" aria-labelledby="process-h">
      <SectionHeadInline id="process-h" num="Process" title="Five weeks, <em>four tracks.</em>" lede="Develop, audit, explain, validate — in parallel, not in series." />

      <ol class="process-steps">
        <li data-reveal><span class="step-k">Step 01</span><h3>Develop</h3><p>Five candidate models, consistent splits, no peeking.</p></li>
