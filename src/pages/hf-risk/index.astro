<script>
  // Live tool status: no-cors probe (opaque response = reachable).
  (function () {
    var TOOL_URL = 'https://hf-risk-heart-failure-ml.onrender.com/';
    var tag = document.getElementById('toolTag');
    var cta = document.getElementById('toolCta');
    var settled = false;

    function mark(state) {
      if (settled) return;
      settled = true;
      if (!tag) return;
      if (state === 'live') {
        tag.classList.remove('checking');
        tag.classList.add('ok');
        tag.textContent = 'Live';
      } else {
        tag.classList.remove('checking');
        tag.classList.add('down');
        tag.textContent = 'Cold-start / unreachable';
        if (cta) {
          cta.textContent = 'Tool is waking up — try again in a moment \u2192';
        }
      }
    }

    tag && tag.classList.add('checking');
    var timer = setTimeout(function () { mark('down'); }, 7000);
    fetch(TOOL_URL, { mode: 'no-cors', cache: 'no-store' })
      .then(function () { clearTimeout(timer); mark('live'); })
      .catch(function () { clearTimeout(timer); mark('down'); });
  })();

  // Lightbox for figures.
  (function () {
    var lb = document.getElementById('lightbox');
    var img = document.getElementById('lbImg');
    var title = document.getElementById('lbTitle');
    var meta = document.getElementById('lbMeta');
    if (!lb) return;

    function open(fig) {
      var src = fig.getAttribute('data-src');
      var t = fig.getAttribute('data-title') || '';
      var c = fig.getAttribute('data-cap') || '';
      var realImg = fig.querySelector('img');
      img.src = src || (realImg && realImg.src) || '';
      img.alt = t;
      title.textContent = t;
      meta.textContent = c;
      lb.classList.add('open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lb-open');
    }

    function close() {
      lb.classList.remove('open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('lb-open');
      img.src = '';
    }

    document.querySelectorAll('.fig.zoom').forEach(function (fig) {
      fig.setAttribute('tabindex', '0');
      fig.addEventListener('click', function () { open(fig); });
      fig.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(fig);
        }
      });
    });

    lb.addEventListener('click', function (e) {
      if (e.target.closest('[data-lb-close]')) close();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && lb.classList.contains('open')) close();
    });
  })();
</script>

