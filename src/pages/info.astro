---
import Layout from '../components/Layout.astro';
import SectionHead from '../components/SectionHead.astro';

const email = 'prajapatinick85@gmail.com';

const timeline = [
  {
    date: 'Apr 2026 —',
    title: 'Customer Service Manager — Ladbrokes / Entain, Harrow',
    body: 'Leading the floor: shift rota, complaint resolution, and coaching a team on service standards under Gala Coral Group brand guidelines.',
    metric: 'Leadership',
  },
  {
    date: 'Nov 2025 – May 2026',
    title: 'AI Response Evaluator — TMX China',
    body: 'Scored and calibrated AI-generated responses against rubric quality bars; fed systematic failure patterns back to the model team.',
    metric: 'LLM evaluation',
  },
  {
    date: 'Oct 2025 – present',
    title: 'Card-sorting analysis — internship under Dr. Subeksha Shrestha',
    body: 'Behavioural data internship (London Met module): cleaned and analysed 845 recorded trials of spatial card-sorting; built the interactive analysis viewer.',
    metric: '845 trials',
  },
  {
    date: 'Sep 2025 – Jul 2026',
    title: 'MSc Data Analytics — London Metropolitan University',
    body: 'Completed July 2026. Dissertation: HF-RISK — clinical outcome prediction with a full leakage audit, a patient-grouped MIMIC-IV extension, and a Streamlit prototype.',
    metric: 'MSc · Jul 2026',
  },
  {
    date: 'May 2025 – Apr 2026',
    title: 'Admin — PHC Home Care',
    body: 'Care records, log validation, incident tracking and audit readiness; built the website for a secondary company (chi ezahomecare.co.uk).',
    metric: 'Compliance',
  },
  {
    date: 'Aug 2025',
    title: 'Community Volunteer — Metropolitan Police',
    body: 'Safer Neighbourhoods volunteering: community engagement and local safety outreach in London.',
    metric: 'Community',
  },
  {
    date: 'Feb – Mar 2026',
    title: 'HF-RISK dissertation — heart failure outcome prediction',
    body: 'Four horizons (28-day, 3-month, 6-month mortality; 6-month readmission) on 2,008 Zhang/PhysioNet patients, reduced to 143 predictors by a full leakage audit. XGBoost: 0.710 AUROC internal at six months; 0.599 on MIMIC-IV without retraining. Random Forest wins the short horizons (0.781 / 0.839). Current as of the Oct 2026 extension: a patient-grouped MIMIC-IV retrain showed GCS components add +0.0138 AUROC at 28 days beyond a 34-feature baseline, and still add +0.0104 on top of an ICU-stay control. The on-site tool runs that retrained pair of models in the browser.',
    metric: '+0.0138 AUROC',
  },
  {
    date: 'Prior',
    title: 'B.Sc. Mathematics (Jun 2021) · Bachelor of Education (Apr 2023) — Gujarat University',
    body: 'Two separate undergraduate degrees, not two of the same: mathematics first, then a Bachelor of Education. One taught the modelling, the other the explaining.',
    metric: 'B.Sc. + B.Ed.',
  },
];

const facts = [
  { k: 'London, UK', lbl: 'Location' },
  { k: 'MSc Data Analytics', lbl: 'Completed Jul 2026' },
  { k: 'Ladbrokes / Entain', lbl: 'Day role' },
  { k: 'Open to graduate roles', lbl: 'Availability' },
];

const professional = [
  'Attention to detail',
  'Data integrity & compliance',
  'Analytical thinking',
  'Clear communication',
  'Process improvement',
  'Stakeholder collaboration',
  'Professionalism under pressure',
  'Confidential data handling',
];

const beyond = [
  { title: 'Ancient history', body: 'Especially Egypt — temple economies to tomb logistics.' },
  { title: 'Fitness & running', body: 'Long slow distance; discipline as data collection.' },
  { title: 'Self-development', body: 'Habits, systems, and honest self-review.' },
  { title: 'Continuous learning', body: 'New methods, new datasets, new questions.' },
];

const languages = ['Python', 'pandas', 'NumPy', 'scikit-learn', 'SHAP', 'Plotly', 'Streamlit', 'lifelines', 'matplotlib', 'SQL', 'R', 'JavaScript'];
const methods = ['Statistical Modelling', 'Predictive Analytics', 'Data Cleaning', 'Feature Engineering', 'Data Visualisation', 'Power BI', 'Behavioural Analysis', 'Compliance-aware data handling'];

const SITE = 'https://realnik.co.uk';
const schema = {
  '@type': 'ProfilePage',
  '@id': `${SITE}/info/#webpage`,
  url: `${SITE}/info/`,
  name: 'About · Curriculum Vitae — Nikunj Prajapati',
  description:
    'Work history, education and skills of Nikunj Prajapati: MSc Data Analytics postgraduate and Customer Service Manager in London.',
  about: { '@id': `${SITE}/#person` },
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: { '@id': `${SITE}/#person` },
};
---

<Layout
  title="About · Curriculum Vitae"
  description="Nikunj Prajapati: MSc Data Analytics postgraduate, service manager, behavioural data explorer. Full work history, skills and contact."
  ogType="profile"
  keywords={[
    'Nikunj Prajapati CV',
    'data analyst London graduate',
    'MSc Data Analytics London Met',
    'data analytics skills Python SQL',
    'graduate data analyst portfolio',
  ]}
  schema={schema}
>
  <!-- ============ BIO HERO ============ -->
  <header class="bio-hero wrap">
    <div class="bio-main" data-reveal>
      <p class="eyebrow">About · Curriculum Vitae</p>
      <h1>
        Data Analytics Postgraduate, <em>service manager,</em><br />
        behavioural data explorer.
      </h1>
      <p class="lede">
        I finished an MSc in Data Analytics at London Metropolitan
        University in July 2026, moving from mathematics and education into
        clinical and behavioural analytics. The two undergraduate degrees
        listed below are often read as a pair of BScs — they aren't: a B.Sc.
        in Mathematics, then a Bachelor of Education. One taught me to model,
        the other to explain. The day job taught me to handle data that has
        to be right the first time.
      </p>
      <p class="lede">
        My dissertation — HF-RISK — audits leakage in heart-failure
        outcome prediction and still lands at 0.710 AUROC internally.
        My behavioural work turns 845 messy human trials into a
        readable signal. Both share one rule: honest numbers only.
      </p>
      <div class="bio-cta">
        <a class="btn btn-solid" href={`mailto:${email}`}>
          Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn-ghost" href="/projects/">See projects</a>
      </div>
    </div>

    <aside class="portrait" data-reveal="1" aria-label="Portrait placeholder — Nikunj Prajapati, London 2026">
      <div class="portrait-frame">
        <div class="portrait-top">
          <span>NP · 2026</span>
          <span>London</span>
        </div>
        <p class="portrait-mono">Nikunj<br />Prajapati.</p>
        <div class="portrait-tail">
          <span>MSc · Data Analytics</span>
          <span>he/him</span>
        </div>
      </div>
    </aside>
  </header>

  <!-- ============ FACT STRIP ============ -->
  <div class="stat-strip wrap-narrow" role="list">
    {facts.map((f, i) => (
      <div class="stat" role="listitem" data-reveal={String(Math.min(i, 4))}>
        <p class="k k-small">{f.k}</p>
        <p class="lbl">{f.lbl}</p>
      </div>
    ))}
  </div>

  <!-- ============ 01 EXPERIENCE & EDUCATION ============ -->
  <section class="section wrap-narrow" aria-labelledby="exp-h">
    <SectionHead
      id="exp-h"
      num="01 · Experience & Education"
      title="Three strands, <em>one stack.</em>"
      lede="Service leadership, AI evaluation and analytics research — each strand feeds the others."
    />

    <div class="two-col">
      <div class="block" data-reveal>
        <p class="block-k">Current experience</p>
        <h3>Customer Service Manager — Ladbrokes / Entain</h3>
        <ul class="check-list">
          <li>Floor leadership — shift rota planning, complaint resolution, team coaching</li>
          <li>Service standards — coaching staff under Gala Coral Group brand guidelines</li>
          <li>Rota management — staffing allocation across rotating shifts</li>
          <li>Customer escalation — flags, resolves, and follows through on issues</li>
        </ul>
      </div>
      <div class="block" data-reveal="1">
        <p class="block-k">Education</p>
        <ul class="edu-list">
          <li>
            <strong>MSc Data Analytics</strong> — London Metropolitan University
            <span>Jul 2026</span>
          </li>
          <li>
            <strong>B.Sc. Mathematics</strong> — Gujarat University
            <span>Jun 2021</span>
          </li>
          <li>
            <strong>Bachelor of Education</strong> — Gujarat University
            <span>Apr 2023</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 02 TIMELINE ============ -->
  <section class="section wrap-narrow" aria-labelledby="timeline-h">
    <SectionHead
      id="timeline-h"
      num="02 · Timeline"
      title="By the <em>numbers.</em>"
      lede="The full record — every role, every project, every date I can stand behind."
    />

    <ol class="timeline-list">
      {timeline.map((t, i) => (
        <li class="t-row" data-reveal={String(Math.min(i % 4 + 1, 4))}>
          <span class="t-date">{t.date}</span>
          <div class="t-body">
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
          <span class="t-metric">{t.metric}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ 03 TOOLBELT ============ -->
  <section class="section wrap-narrow" aria-labelledby="tools-h">
    <SectionHead
      id="tools-h"
      num="03 · The toolbelt"
      title="Languages & <em>methods.</em>"
      lede="What I reach for, in order of frequency."
    />

    <div class="skills-cloud">
      <div class="skills-block" data-reveal>
        <p class="block-k">Languages & libraries</p>
        <ul class="skills-row">
          {languages.map((s) => <li class="skill">{s}</li>)}
        </ul>
      </div>
      <div class="skills-block" data-reveal="1">
        <p class="block-k">Methods</p>
        <ul class="skills-row">
          {methods.map((s) => <li class="skill">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 04 TEAM ============ -->
  <section class="section wrap-narrow" aria-labelledby="team-h">
    <SectionHead
      id="team-h"
      num="04 · What I'm like on a team"
      title="Professional, <em>curious,</em> careful."
    />

    <div class="two-col">
      <div data-reveal>
        <p class="block-k">Professional skills</p>
        <ul class="check-list">
          {professional.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="beyond-grid" data-reveal="1">
        <p class="block-k">Beyond work</p>
        {beyond.map((b) => (
          <div class="beyond-card">
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="work-notes" data-reveal>
      <p class="block-k">How I work</p>
      <dl class="notes-list">
        <div>
          <dt>Checked before shown</dt>
          <dd>
            Every figure on this site can be traced to a script and a run log.
            If a number can't be reproduced, it doesn't get published.
          </dd>
        </div>
        <div>
          <dt>Empty means empty</dt>
          <dd>
            I don't impute a clinical value to make a table look complete, and
            I don't drop an inconvenient subgroup to tidy a result.
          </dd>
        </div>
        <div>
          <dt>Limits travel with the result</dt>
          <dd>
            Sample size, cohort selection and dataset shift are written next to
            the number, not buried in a footnote.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="contact-band" id="contact" aria-labelledby="contact-h">
    <div class="wrap contact-inner">
      <h2 data-reveal id="contact-h">Let's build something <em>insightful</em> together.</h2>
      <form
        class="contact-form"
        data-reveal="1"
        data-endpoint="/api/contact"
        novalidate
      >
        <div class="form-fields">
          <label>
            <span>Name</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label class="full">
            <span>Topic</span>
            <input type="text" name="topic" placeholder="Project, question, or just say hello" />
          </label>
          <label class="full">
            <span>Message</span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          <button class="btn btn-solid" type="submit">
            Send message <span class="arrow" aria-hidden="true">&rarr;</span>
          </button>
          <div class="form-honey" aria-hidden="true">
            <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
        </div>
        <div class="form-status" role="status" aria-live="polite"></div>
      </form>
      <ul class="contact-tags" data-reveal="2">
        <li class="tag"><a href={`mailto:${email}`}>{email}</a></li>
        <li class="tag">London, UK</li>
        <li class="tag">Available now</li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .bio-hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 120px) clamp(40px, 5vw, 72px);
  }

  .bio-main h1 {
    font-size: clamp(32px, 4.2vw, 56px);
    margin: 0 0 0.5em;
  }

  .bio-main h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .lede {
    max-width: 62ch;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .bio-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .portrait-frame {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(18px, 2vw, 28px);
  }

  .portrait-top,
  .portrait-tail {
    display: flex;
    justify-content: space-between;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .portrait-mono {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 36px);
    margin: 0;
    line-height: 1.15;
  }

  .k-small {
    font-size: clamp(15px, 1.6vw, 20px) !important;
    line-height: 1.3 !important;
    font-family: var(--font-display);
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
  }

  .block-k,
  .skills-block .block-k {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 16px;
  }

  .block h3 {
    font-size: 20px;
    margin-bottom: 14px;
  }

  .check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .check-list li {
    padding-left: 24px;
    position: relative;
    font-size: 14px;
    color: var(--fg-muted);
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 10px;
    height: 10px;
    border: 1px solid var(--theme-primary);
    border-radius: 2px;
    background: linear-gradient(135deg, var(--theme-primary) 0 50%, transparent 50% 100%);
  }

  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .edu-list li {
    font-size: 15px;
    border-left: 1px solid var(--rule);
    padding-left: 16px;
  }

  .edu-list strong { font-family: var(--font-display); }

  .edu-list span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-top: 4px;
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .t-row {
    display: grid;
    grid-template-columns: 130px 2.4fr 1fr;
    gap: clamp(16px, 2.4vw, 32px);
    padding-block: clamp(20px, 2.6vw, 32px);
    border-bottom: 1px solid var(--rule-soft);
    align-items: start;
  }

  .t-row:first-child { border-top: 1px solid var(--rule-soft); }

  .t-date {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 6px;
    white-space: nowrap;
  }

  .t-body h3 {
    font-size: clamp(16px, 1.6vw, 20px);
    margin-bottom: 8px;
  }

  .t-body p {
    margin: 0;
    font-size: 13.5px;
    color: var(--fg-muted);
  }

  .t-metric {
    justify-self: end;
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-primary);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 5px 14px;
    white-space: nowrap;
  }

  .skills-cloud {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
  }

  .skills-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 12.5px;
    color: var(--fg);
    transition: all 250ms var(--ease-out);
  }

  .skill:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .beyond-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .beyond-grid .block-k { grid-column: 1 / -1; }

  .beyond-card {
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    padding: 18px 20px;
    background: var(--card);
  }

  .beyond-card h3 {
    font-size: 15px;
    margin-bottom: 6px;
  }

  .beyond-card p {
    margin: 0;
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  .work-notes {
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--rule);
  }

  .notes-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
  }

  .notes-list dt {
    font-size: 13.5px;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .notes-list dd {
    margin: 0;
    font-size: 13.5px;
    color: var(--fg-muted);
  }

  @media (max-width: 820px) {
    .notes-list { grid-template-columns: 1fr; }
  }

  .contact-band {
    border-top: 1px solid var(--rule);
    margin-top: clamp(72px, 9vw, 120px);
    padding-block: clamp(64px, 8vw, 110px);
    padding-bottom: clamp(64px, 8vw, 110px);
  }

  .contact-inner {
    max-width: 720px;
    margin-inline: auto;
    padding-block: clamp(40px, 5vw, 64px);
    text-align: center;
  }

  .contact-inner h2 {
    font-size: clamp(28px, 4vw, 52px);
    margin-bottom: 26px;
  }

  .contact-inner h2 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .contact-form {
    max-width: 640px;
    margin-inline: auto;
  }

  .form-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form-fields label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .form-fields .full {
    grid-column: 1 / -1;
  }

  .form-fields input,
  .form-fields textarea {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--fg);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 12px 14px;
    resize: vertical;
  }

  .form-fields input:focus,
  .form-fields textarea:focus {
    outline: 2px solid var(--theme-primary);
    outline-offset: 1px;
  }

  /* The status live region must stay in the accessibility tree to be
     announced, so it is never `hidden`; :empty keeps it from taking space. */
  .form-status:empty { display: none; }

  /* Honeypot: off-screen and untabbable for people, tempting for bots. */
  .form-honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-display);
    font-size: 20px;
    padding: 24px;
    margin-top: 18px;
    border: 1px solid var(--theme-primary);
    border-radius: 4px;
    background: var(--card);
    color: var(--fg);
  }

  .form-done {
    text-align: center;
    font-family: var(--font-display);
    font-size: 20px;
    padding: 24px;
  }

  .contact-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .contact-tags .tag a { text-decoration: none; }
  .contact-tags .tag a:hover { color: var(--bg); }
  .contact-tags .tag:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  @media (max-width: 900px) {
    .bio-hero { grid-template-columns: 1fr; }
    .portrait { max-width: 380px; }
    .two-col,
    .skills-cloud { grid-template-columns: 1fr; }
  }

  @media (max-width: 760px) {
    .t-row { grid-template-columns: 1fr; gap: 8px; }
    .t-metric { justify-self: start; }
    .form-fields { grid-template-columns: 1fr; }
  }
</style>
