---
import Layout from '../../components/Layout.astro';
import Tag from '../../components/Tag.astro';

const projects = [
  {
    idx: '01',
    title: 'HF-RISK — Predicting Heart Failure Outcomes with Machine Learning',
    desc: 'Leakage-clean ML pipeline on 2,008 patients: five models compared, 143 final predictors, SHAP-driven explainability.',
    tags: ['MSc Dissertation', 'Random Forest', 'XGBoost', 'SHAP', 'MIMIC-IV'],
    meta: ['2026', 'London Met', 'Clinical ML'],
    outcome: 'Primary outcome: 6-month mortality at 0.710 AUROC on the held-out Zhang cohort and 0.599 on MIMIC-IV without retraining.',
    href: '/hf-risk/',
    cta: 'Read',
  },
  {
    idx: '02',
    title: 'Interactive Card Sorting — Spatial Organization & Cognitive Strategy Analysis',
    desc: 'How people arrange cards on an 8×8 board — across 845 recorded trials, with an interactive viewer for retry tracing.',
    tags: ['Behavioural', 'Python', 'Interactive viewer'],
    meta: ['2026', 'London Met', 'Behavioural'],
    outcome: 'Organized layouts correlated with completion; strategy quality added explanatory power beyond time-on-task. Live explorer for retry tracing.',
    href: '/cards-analysis/',
    cta: 'Open',
  },
];

const filters = ['All', 'Clinical ML', 'Behavioural', '2026'];
---

<Layout
  title="Selected Work"
  description="A short, honest list of projects by Nikunj Prajapati — clinical ML and behavioural analysis, with results that survive scrutiny."
>
  <header class="page-hero wrap">
    <p class="eyebrow" data-reveal>Projects</p>
    <h1 data-reveal="1">Selected <em>work.</em></h1>
    <p class="deck" data-reveal="2">
      A short, honest list. Two projects, both finished, both documented
      end to end — including the parts that didn't work.
    </p>
  </header>

  <section class="section wrap" aria-label="Project list">
    <div class="filter-bar" data-reveal>
      <p class="filter-count" id="projectCount">{projects.length} projects</p>
      <div class="filters" role="group" aria-label="Filter projects">
        {filters.map((f, i) => (
          <button
            type="button"
            class="filter-btn"
            data-filter={f}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f}
          </button>
        ))}
      </div>
    </div>

    <ol class="proj-list" id="projList">
      {projects.map((p, i) => (
        <li
          class="proj-row"
          data-reveal={String(Math.min(i + 1, 4))}
          data-categories={p.tags.concat(p.meta).join(' ').toLowerCase()}
        >
          <span class="proj-idx" aria-hidden="true">{p.idx}</span>
          <div class="proj-main">
            <h3>{p.title}</h3>
            <p class="proj-desc">{p.desc}</p>
            <Tag tags={p.tags} />
          </div>
          <div class="proj-meta">
            {p.meta.map((m) => <p>{m}</p>)}
          </div>
          <div class="proj-outcome">
            <p>{p.outcome}</p>
          </div>
          <a class="proj-go" href={p.href}>
            {p.cta} <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="process-note">
      <h3 data-reveal>Why so <em>few?</em></h3>
      <div data-reveal="1">
        <p>
          Because a portfolio of ten unfinished experiments says more about
          enthusiasm than judgement. Each project here shipped with a
          documented method, a checked pipeline, and a written account of
          its limits.
        </p>
        <p>
          More is coming: clinical survival modelling and behavioural
          tooling from the MSc, plus the day-job analytics work that pays
          the rent. I'd rather publish four honest pieces than forty
          polished claims.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Project filtering — vanilla, progressive enhancement.
  const buttons = document.querySelectorAll('.filter-btn');
  const rows = Array.from(document.querySelectorAll('.proj-row'));
  const count = document.getElementById('projectCount');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'All';
      buttons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));

      let visible = 0;
      rows.forEach((row) => {
        const cats = (row.getAttribute('data-categories') || '').toLowerCase();
        const show = filter === 'All' || cats.includes(filter.toLowerCase());
        row.style.display = show ? '' : 'none';
        if (show) {
          visible++;
          row.classList.add('is-visible');
        }
      });

      if (count) count.textContent = visible + (visible === 1 ? ' project' : ' projects');
    });
  });
</script>

<style>
  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: clamp(28px, 4vw, 48px);
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .filter-count {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-btn {
    font-family: var(--font-body);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--rule);
    background: none;
    color: var(--fg-muted);
    border-radius: 999px;
    padding: 7px 16px;
    cursor: pointer;
    transition: all 250ms var(--ease-out);
  }

  .filter-btn:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .proj-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .proj-row {
    display: grid;
    grid-template-columns: 64px 2.4fr 1fr 1.6fr 140px;
    gap: clamp(16px, 2.4vw, 32px);
    align-items: start;
    padding-block: clamp(24px, 3vw, 40px);
    border-bottom: 1px solid var(--rule-soft);
  }

  .proj-idx {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--fg-muted);
  }

  .proj-main h3 {
    font-size: clamp(19px, 2vw, 26px);
    margin-bottom: 12px;
  }

  .proj-desc {
    font-size: 14px;
    color: var(--fg-muted);
    margin-bottom: 14px;
  }

  .proj-meta p {
    margin: 0 0 6px;
    font-size: 12.5px;
    color: var(--fg-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11px;
  }

  .proj-outcome p {
    margin: 0;
    font-size: 13.5px;
    color: var(--fg-muted);
    border-left: 2px solid var(--theme-primary);
    padding-left: 14px;
  }

  .proj-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 4px;
    align-self: start;
    margin-top: 6px;
    transition: border-color 250ms var(--ease-out);
  }

  .proj-go:hover { border-color: var(--fg); }

  .process-note {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(48px, 6vw, 80px);
    align-items: start;
  }

  .process-note h3 {
    font-size: clamp(22px, 2.6vw, 32px);
    margin: 0;
  }

  .process-note h3 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .process-note p {
    font-size: 14.5px;
    color: var(--fg-muted);
  }

  @media (max-width: 1080px) {
    .proj-row {
      grid-template-columns: 48px 1fr 1fr;
    }
    .proj-meta { display: none; }
    .proj-go { grid-column: 3; }
  }

  @media (max-width: 760px) {
    .proj-row { grid-template-columns: 1fr; }
    .proj-idx { display: none; }
    .proj-go { grid-column: auto; }
    .process-note { grid-template-columns: 1fr; }
  }
</style>
