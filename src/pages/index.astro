---
import Layout from '../components/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';

const email = 'prajapatinick85@gmail.com';
---

<Layout
  title="Nikunj Prajapati — Data Analytics Portfolio"
  description="Portfolio of Nikunj Prajapati, MSc Data Analytics postgraduate in London. Predictive modelling, data quality, explainability and honest reporting."
>
  <!-- ============ HERO ============ -->
  <header class="hero wrap">
    <div class="eyebrow-row" data-reveal>
      <span>Portfolio · 2026</span>
      <span aria-hidden="true">/</span>
      <span>Nikunj Prajapati</span>
      <span aria-hidden="true">/</span>
      <span>MSc Data Analytics</span>
    </div>

    <h1 data-reveal="1">Behavioural data,<br /><em>made legible.</em></h1>

    <p class="lede" data-reveal="2">
      I'm a data analytics postgraduate in London. I build leakage-clean
      predictive models, interactive behavioural analysis tools, and reports
      that stay honest under scrutiny — because a number only helps if it
      survives the audit.
    </p>

    <div class="hero-cta" data-reveal="3">
      <a class="btn btn-solid" href="/projects/">
        Explore projects <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="btn btn-ghost" href="/info/">About · CV</a>
    </div>

    <dl class="inline-meta" data-reveal="4">
      <div>
        <dt>Currently</dt>
        <dd>MSc Data Analytics · London Met</dd>
      </div>
      <div>
        <dt>Day-to-day</dt>
        <dd>Ladbrokes / Entain — Customer Service Manager</dd>
      </div>
      <div>
        <dt>Working on</dt>
        <dd>Clinical ML · Behavioural analytics</dd>
      </div>
    </dl>
  </header>

  <!-- ============ FEATURED WORK ============ -->
  <section class="section wrap" aria-labelledby="featured-h">
    <SectionHead
      num="Featured work"
      title="Two projects, <em>one standard.</em>"
      lede="Every piece here is built on data I can defend: documented sources, audited pipelines, and results I can reproduce."
    />

    <div class="work-grid">
      <ProjectCard
        index="01"
        eyebrow="Heart-failure ML · 2026"
        gradient="teal-terracotta"
        bigNumber="0.71"
        bigUnit="AUROC · 6-month internal"
        topRow="MSc Dissertation / 2026"
        title="HF-RISK — Predicting Heart Failure Outcomes with Machine Learning"
        desc="A leakage-clean pipeline on 2,008 patients comparing five models. XGBoost reached 0.710 AUROC at six months; SHAP explains the cardiorenal axis it learned — and 0.599 transfers to MIMIC-IV without retraining."
        tags={['Random Forest', 'XGBoost', 'SHAP', 'MIMIC-IV', 'Leakage audit']}
        cta="Read case study"
        href="/hf-risk/"
      />
      <ProjectCard
        index="02"
        eyebrow="Behavioural · 2026"
        gradient="sand-teal"
        bigNumber="845"
        bigUnit="recorded trials · 714 usable"
        topRow="MSc Module / 2026"
        title="Interactive Card Sorting — Spatial Organization & Cognitive Strategy"
        desc="Given cards — and sometimes blanks — on an 8×8 board, how do people organise what matters? 845 recorded trials show organisation beats raw effort, and blank cards act as scaffolding. Live explorer for retry tracing."
        tags={['Python', 'Behavioural', 'Interactive viewer']}
        cta="Open the viewer"
        href="/cards-analysis/"
      />
    </div>
  </section>

  <!-- ============ CAPABILITIES ============ -->
  <section class="section wrap" aria-labelledby="caps-h">
    <SectionHead
      num="Capabilities"
      title="What I actually <em>do.</em>"
      lede="Four moves, repeated carefully: model, clean, explain, report."
    />

    <ol class="caps-grid">
      <li data-reveal>
        <span class="cap-num" aria-hidden="true">i</span>
        <h3>Predictive modelling</h3>
        <p>Regression, survival models, tree ensembles — benchmarked honestly, with baselines.</p>
      </li>
      <li data-reveal="1">
        <span class="cap-num" aria-hidden="true">ii</span>
        <h3>Data quality</h3>
        <p>Missingness audits, leakage hunting, and feature hygiene before any model sees the data.</p>
      </li>
      <li data-reveal="2">
        <span class="cap-num" aria-hidden="true">iii</span>
        <h3>Explainability</h3>
        <p>SHAP-driven reduction and calibration checks, so stakeholders can see why a model says what it says.</p>
      </li>
      <li data-reveal="3">
        <span class="cap-num" aria-hidden="true">iv</span>
        <h3>Reporting</h3>
        <p>Board-ready dashboards and static reports that separate signal from confidence theatre.</p>
      </li>
    </ol>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="section wrap" aria-labelledby="approach-h">
    <SectionHead
      num="Approach"
      title="Three principles I <em>don't bend.</em>"
    />

    <ol class="approach-grid">
      <li data-reveal>
        <p class="approach-num">01</p>
        <h3>Integrity before performance</h3>
        <p>A high AUROC built on leaked features is a liability, not an achievement. I audit first, then report what survives.</p>
      </li>
      <li data-reveal="1">
        <p class="approach-num">02</p>
        <h3>Explainability is the deliverable</h3>
        <p>A model nobody can question is a model nobody can trust. SHAP, calibration and honest failure modes are part of the work.</p>
      </li>
      <li data-reveal="2">
        <p class="approach-num">03</p>
        <h3>Small is honest</h3>
        <p>With 2,008 patients or 845 trials, I report what the data can actually support — and say plainly when that's a limit.</p>
      </li>
    </ol>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-band" aria-labelledby="cta-h">
    <div class="wrap cta-inner">
      <h2 data-reveal id="cta-h">Let's build something <em>insightful</em> together.</h2>
      <div class="cta-row" data-reveal="1">
        <a class="btn btn-solid" href={`mailto:${email}`}>
          Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn-ghost" href="/cv/nikunj-prajapati-cv.pdf">
          Download CV <span class="arrow" aria-hidden="true">&darr;</span>
        </a>
      </div>
      <p class="cta-muted" data-reveal="2">· London, UK · Available from 2026 ·</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(72px, 10vw, 140px) clamp(40px, 5vw, 72px);
    max-width: var(--max-w);
  }

  .eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .hero h1 {
    font-size: clamp(44px, 7.5vw, 104px);
    margin-bottom: 0.45em;
  }

  .hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .lede {
    max-width: 62ch;
    font-size: clamp(15px, 1.4vw, 18px);
    color: var(--fg-muted);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .inline-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 40px);
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule-soft);
  }

  .inline-meta dt {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 6px;
  }

  .inline-meta dd {
    margin: 0;
    font-size: 14px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 40px);
  }

  .caps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--rule-soft);
    border: 1px solid var(--rule-soft);
  }

  .caps-grid li {
    background: var(--bg);
    padding: clamp(22px, 2.6vw, 36px);
  }

  .cap-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    color: var(--theme-primary);
    display: block;
    margin-bottom: 14px;
  }

  .caps-grid h3 {
    font-size: 17px;
    margin-bottom: 10px;
  }

  .caps-grid p {
    font-size: 13.5px;
    color: var(--fg-muted);
    margin: 0;
  }

  .approach-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 40px);
  }

  .approach-grid li {
    border-top: 1px solid var(--rule);
    padding-top: 20px;
  }

  .approach-num {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--fg-muted);
    margin-bottom: 12px;
  }

  .approach-grid h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }

  .approach-grid p {
    font-size: 14px;
    color: var(--fg-muted);
    margin: 0;
  }

  .cta-band {
    border-top: 1px solid var(--rule);
    margin-top: clamp(72px, 9vw, 120px);
    padding-block: clamp(64px, 8vw, 110px);
    text-align: center;
  }

  .cta-inner h2 {
    font-size: clamp(32px, 4.6vw, 64px);
    margin-bottom: 28px;
  }

  .cta-inner h2 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .cta-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .cta-muted {
    margin-top: 28px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  @media (max-width: 1000px) {
    .caps-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    .work-grid,
    .approach-grid { grid-template-columns: 1fr; }
    .inline-meta { grid-template-columns: 1fr; gap: 18px; }
  }

  @media (max-width: 560px) {
    .caps-grid { grid-template-columns: 1fr; }
  }
</style>
