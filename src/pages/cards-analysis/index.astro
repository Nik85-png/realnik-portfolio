---
import Layout from '../../components/Layout.astro';

const email = 'prajapatinick85@gmail.com';

// Structured data: ties this page to card-sorting / cognitive-strategy queries.
const SITE = 'https://realnik.co.uk';
const schema = {
  '@type': 'CreativeWork',
  '@id': `${SITE}/cards-analysis/#work`,
  name: 'Interactive Card Sorting — Spatial Organization & Cognitive Strategy',
  description:
    'A behavioural psychology data project analysing 845 recorded card-sorting trials on an 8×8 board. Spatial organisation predicted completion better than time on task, and blank cards acted as scaffolding; the interactive viewer exposes nine analysis modes.',
  url: `${SITE}/cards-analysis/`,
  inLanguage: 'en-GB',
  creator: { '@id': `${SITE}/#person` },
  about: [
    { '@type': 'Thing', name: 'Card sorting' },
    { '@type': 'Thing', name: 'Cognitive strategy' },
    { '@type': 'Thing', name: 'Behavioural data analysis' },
  ],
  keywords: [
    'card sorting psychology',
    'card sorting experiment',
    'spatial organisation',
    'cognitive strategy',
    'blank card scaffolding',
    'behavioural data analysis',
  ],
  isPartOf: { '@id': `${SITE}/#website` },
};
---

<Layout
  title="Card Sorting & Cognitive Strategy Analysis"
  description="845 recorded trials of spatial card sorting on an 8×8 board. Interactive analysis viewer with nine views, retry tracing, and statistics."
  keywords={[
    'card sorting psychology project',
    'card sorting experiment analysis',
    'spatial organisation cognitive strategy',
    'blank card paradox',
    'behavioural data analysis project',
    'interactive data viewer',
  ]}
  schema={schema}
>
  <!-- ===== hero ===== -->
  <header class="cards-hero wrap">
    <div class="eyebrow-row" data-reveal>
      <span>London Met</span>
      <span aria-hidden="true">/</span>
      <span>Behavioural analysis</span>
      <span aria-hidden="true">/</span>
      <span>2026</span>
    </div>
    <h1 data-reveal="1">Interactive Card Sorting <em>Analysis.</em></h1>
    <p class="deck" data-reveal="2">
      Given KQJ blank cards and an 8×8 board, how do people arrange
      what matters — and what does the mess reveal about strategy?
      845 recorded trials, nine analysis views, one honest read.
    </p>

    <dl class="cards-meta" data-reveal="3">
      <div><dt>Project</dt><dd>Spatial organisation and cognitive strategy</dd></div>
      <div><dt>Artifact</dt><dd>Interactive analysis viewer with 9 analysis modes</dd></div>
      <div><dt>Focus</dt><dd>Participant trials, messiness, blank-card scaffolding</dd></div>
      <div><dt>Stack</dt><dd>Vanilla JavaScript, Plotly, static JSON data</dd></div>
    </dl>
  </header>

  <!-- ===== embedded viewer ===== -->
  <section class="wrap" aria-label="Interactive card sorting analysis viewer">
    <div class="cards-app-bar" data-reveal>
      <span class="dots" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <span class="app-bar-title">Full card analysis page &middot; animation viewer &middot; statistics &middot; documentation</span>
      <a class="app-bar-open" href="/cards-viewer/index.html" target="_blank" rel="noopener noreferrer">Open full page &rarr;</a>
    </div>

    <div class="cards-frame-wrap" data-reveal="1">
      <iframe
        id="cardsExplorerFrame"
        class="cards-app-frame"
        src="/cards-viewer/index.html?embed=1"
        title="Interactive card sorting analysis viewer"
        loading="lazy"
      ></iframe>
    </div>

    <div class="cards-note">
      <article data-reveal>
        <p class="note-k">Dataset</p>
        <h3>845 trials</h3>
        <p>Every recorded attempt, cleaned to 714 usable trials — the messiness is part of the signal, not noise to discard.</p>
      </article>
      <article data-reveal="1">
        <p class="note-k">Viewer</p>
        <h3>9 analyses</h3>
        <p>From clean patterns to extreme cases: move-by-move replay, progression, recovery, speed and repetition views.</p>
      </article>
      <article data-reveal="2">
        <p class="note-k">Signal</p>
        <h3>Messiness</h3>
        <p>Organisation beats raw effort, and blank cards act as scaffolding — recovery attempts are rare but informative.</p>
      </article>
    </div>
  </section>

  <!-- ===== project nav ===== -->
  <nav class="proj-nav wrap" aria-label="Project navigation">
    <a class="proj-nav-prev" href="/hf-risk/">
      <span class="pn-k">&larr; Previous</span>
      <span class="pn-title">HF-RISK — Predicting Heart Failure Outcomes</span>
    </a>
    <a class="proj-nav-next" href="/projects/">
      <span class="pn-k">Next &rarr;</span>
      <span class="pn-title">All projects</span>
    </a>
  </nav>

  <!-- ===== contact strip ===== -->
  <section class="contact-strip" aria-labelledby="cards-contact-h">
    <div class="wrap contact-inner">
      <h2 id="cards-contact-h" data-reveal>The data stays <em>private.</em></h2>
      <p class="contact-note" data-reveal="1">
        Participant trials are covered by the study's ethics and data-handling
        terms, so the raw dataset isn't shared. What is public: the interactive
        viewer above, the documented method, and every statistic quoted on this
        page — I'm happy to talk through how any of them was derived, and how
        the study could be replicated.
      </p>
      <div data-reveal="2">
        <a class="btn btn-solid" href={`mailto:${email}`}>
          Ask about the method <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Keep the embedded viewer's height in sync via postMessage.
  (function () {
    var frame = document.getElementById('cardsExplorerFrame');
    if (!frame) return;

    window.addEventListener('message', function (e) {
      if (e.origin !== window.location.origin) return;
      if (!e.data || e.data.type !== 'cards-embed-height') return;
      frame.style.minHeight = Math.max(1600, e.data.height + 20) + 'px';
    });
  })();
</script>

<style>
  .cards-hero {
    padding-block: clamp(64px, 9vw, 120px) clamp(32px, 4vw, 56px);
  }

  .eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 28px;
  }

  .cards-hero h1 {
    font-size: clamp(40px, 6.4vw, 88px);
    margin-bottom: 0.4em;
  }

  .cards-hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .deck {
    max-width: 62ch;
    font-size: clamp(14px, 1.3vw, 17px);
    color: var(--fg-muted);
  }

  .cards-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px 32px;
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule-soft);
  }

  .cards-meta div { margin: 0; }

  .cards-meta dt {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 4px;
  }

  .cards-meta dd {
    margin: 0;
    font-size: 13.5px;
  }

  /* ---- app bar ---- */
  .cards-app-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1px solid var(--rule);
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
    background: color-mix(in oklch, var(--fg) 4%, var(--card));
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--rule);
  }

  .app-bar-title {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-bar-open {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .app-bar-open:hover { color: var(--fg); }

  .cards-frame-wrap {
    border: 1px solid var(--rule);
    border-radius: 0 0 10px 10px;
    overflow: hidden;
    background: var(--card);
  }

  .cards-app-frame {
    display: block;
    width: 100%;
    min-height: 2450px;
    border: 0;
  }

  @media (max-width: 1100px) {
    .cards-app-frame { min-height: 2850px; }
  }

  @media (max-width: 760px) {
    .cards-app-frame { min-height: 3150px; }
    .cards-meta { grid-template-columns: repeat(2, 1fr); }
    .app-bar-title { display: none; }
  }

  /* ---- notes ---- */
  .cards-note {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(40px, 5vw, 64px);
  }

  .cards-note article {
    border-top: 1px solid var(--rule);
    padding-top: 18px;
  }

  .note-k {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--theme-primary);
    margin: 0 0 10px;
  }

  .cards-note h3 {
    font-size: clamp(22px, 2.4vw, 30px);
    margin-bottom: 10px;
  }

  .cards-note p:last-child {
    margin: 0;
    font-size: 13.5px;
    color: var(--fg-muted);
  }

  @media (max-width: 860px) {
    .cards-note { grid-template-columns: 1fr; }
  }

  /* ---- project nav ---- */
  .proj-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2.4vw, 32px);
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: clamp(28px, 3vw, 40px);
    border-top: 1px solid var(--rule-soft);
  }

  .proj-nav a {
    text-decoration: none;
    padding: 20px 24px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 250ms var(--ease-out);
  }

  .proj-nav a:hover {
    border-color: var(--fg);
    transform: translateY(-2px);
  }

  .proj-nav-next { text-align: right; align-items: flex-end; }

  .pn-k {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .pn-title {
    font-family: var(--font-display);
    font-size: clamp(15px, 1.6vw, 19px);
  }

  /* ---- contact strip ---- */
  .contact-strip {
    border-top: 1px solid var(--rule);
    margin-top: clamp(72px, 9vw, 120px);
    padding-block: clamp(64px, 8vw, 110px);
    text-align: center;
  }

  .contact-inner h2 {
    font-size: clamp(30px, 4.4vw, 58px);
    margin-bottom: 26px;
  }

  .contact-inner h2 em {
    font-style: italic;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .contact-note {
    max-width: 62ch;
    margin: 0 auto 28px;
    font-size: 14px;
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    .proj-nav { grid-template-columns: 1fr; }
    .proj-nav-next { text-align: left; align-items: flex-start; }
  }
</style>
